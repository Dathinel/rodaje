<Project Sdk="Microsoft.NET.Sdk">

  <!-- ejecutar-vulkan: dibuja los .spv fuera de pantalla y compara con las referencias de WARP. Publicable con AOT (linux-x64). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ejecutar-vulkan</AssemblyName>
    <RootNamespace>Fase0.Shaders</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Como el Directory.Build.targets de la raíz (que aquí no se hereda): el ILCompiler 10.0.12 del SDK tiene un aviso de seguridad. -->
  <ItemGroup>
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler">
      <ILCompilerPackVersion Condition="'%(KnownILCompilerPack.TargetFramework)' == 'net10.0'">10.0.14</ILCompilerPackVersion>
    </KnownILCompilerPack>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Comun\*.cs" Link="Comun\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TerraFX.Interop.Vulkan" Version="1.4.328.1" />
  </ItemGroup>

</Project>
