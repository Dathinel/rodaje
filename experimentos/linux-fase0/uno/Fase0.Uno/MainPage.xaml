<Page x:Class="Fase0.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Fase0.Uno"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid Padding="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind Summary}" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
      <Button x:Name="CountButton" Content="Contar" Click="OnCount" />
      <Button x:Name="CloseButton" Content="Cerrar" Click="OnClose" />
      <TextBlock VerticalAlignment="Center" Text="{x:Bind ClickText, Mode=OneWay}" />
    </StackPanel>
    <ListView Grid.Row="2" ItemsSource="{x:Bind Rows}">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:ClipRow">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Track}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Name}" />
            <TextBlock Grid.Column="2" Text="{x:Bind Start}" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
