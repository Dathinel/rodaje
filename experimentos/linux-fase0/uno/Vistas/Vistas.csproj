<Project Sdk="Uno.Sdk/7.0.22">

  <!--
    Medida de la parte (a): compila el código y el XAML de src\Rodaje.App, sin cambios, contra Uno (net10.0-desktop).
    No se ejecuta ni se publica: solo cuenta qué archivos dan errores (medir-vistas.ps1). Las capas de Windows
    (Media, Engine, Render, Audio, Export) se referencian tal cual para que los errores sean de la interfaz, no de ellas.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <OutputType>Library</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>Rodaje.App</RootNamespace>
    <AssemblyName>Rodaje</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UnoFeatures>Skia;</UnoFeatures>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <NoWarn>$(NoWarn);NU1507;NU1701;NU1702;NETSDK1201;PRI257</NoWarn>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <App>..\..\..\..\src\Rodaje.App</App>
    <Src>..\..\..\..\src</Src>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(App)\**\*.cs" Exclude="$(App)\bin\**;$(App)\obj\**" Link="app\%(RecursiveDir)%(Filename)%(Extension)" />
    <ApplicationDefinition Include="$(App)\App.xaml" Link="app\App.xaml" />
    <Page Include="$(App)\**\*.xaml" Exclude="$(App)\App.xaml;$(App)\bin\**;$(App)\obj\**" Link="app\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(App)\Services\Packages\catalogo.json" LogicalName="Rodaje.App.catalogo.json" />
    <EmbeddedResource Include="$(App)\Services\Packages\clave-catalogo.txt" LogicalName="Rodaje.App.clave-catalogo.txt" />
    <EmbeddedResource Include="$(App)\Services\SafeZones\Fabrica\*.json" LogicalName="Rodaje.App.zonas.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(Src)\Rodaje.Analysis\Rodaje.Analysis.csproj" />
    <ProjectReference Include="$(Src)\Rodaje.Packages\Rodaje.Packages.csproj" />
    <ProjectReference Include="..\..\..\externo\sala\src\Rodaje.Modules.Protocol\Rodaje.Modules.Protocol.csproj" />
    <ProjectReference Include="$(Src)\Rodaje.Core\Rodaje.Core.csproj" />
    <ProjectReference Include="$(Src)\Rodaje.Playback\Rodaje.Playback.csproj" />
    <!-- net10.0-windows: NuGet no deja referenciarlas como proyecto desde net10.0-desktop; van ya compiladas (medir-vistas.ps1). -->
    <Reference Include="$(Src)\Rodaje.Engine\bin\Release\net10.0-windows\Rodaje.Engine.dll" />
    <Reference Include="$(Src)\Rodaje.Export\bin\Release\net10.0-windows\Rodaje.Export.dll" />
    <Reference Include="$(Src)\Rodaje.Render\bin\Release\net10.0-windows\Rodaje.Render.dll" />
    <Reference Include="$(Src)\Rodaje.Media\bin\Release\net10.0-windows\Rodaje.Media.dll" />
    <Reference Include="$(Src)\Rodaje.Audio\bin\Release\net10.0-windows\Rodaje.Audio.dll" />
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLinked" Version="9.0.1.1" />
  </ItemGroup>

  <!-- Los using implícitos de Uno.Sdk (System.Windows.Input, Windows.Storage…) chocan con nombres de Rodaje: la app no los tiene. -->
  <Target Name="QuitarUsingsDeUno" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="@(Using)" Condition="'%(Using.Sdk)' == 'Uno'" />
    </ItemGroup>
  </Target>

</Project>
