<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fase 0 (e) de D-066: eco del protocolo de módulos por socket de dominio Unix y memoria compartida
    (archivo + mmap), en Linux y macOS. El mismo ejecutable hace de editor (padre) y de módulo (hijo).
    No entra en Rodaje.slnx. La publicación AOT la hace la CI (ci.sh); aquí solo se compila.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>eco</AssemblyName>
    <RootNamespace>Rodaje.Experimentos.Eco</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <RuntimeIdentifiers>linux-x64;osx-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Marco y mensajes del protocolo v1, enlazados tal cual (los mismos bytes por el cable que en Windows). -->
    <Compile Include="..\..\..\src\Rodaje.Modules.Protocol\MessageChannel.cs" Link="Protocolo\MessageChannel.cs" />
    <Compile Include="..\..\..\src\Rodaje.Modules.Protocol\Messages.cs" Link="Protocolo\Messages.cs" />
    <Compile Include="..\..\..\src\Rodaje.Modules.Protocol\ModuleExceptions.cs" Link="Protocolo\ModuleExceptions.cs" />
  </ItemGroup>

</Project>
