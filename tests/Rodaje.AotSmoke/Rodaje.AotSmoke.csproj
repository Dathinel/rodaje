<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Prueba de humo de Native AOT: un programa de consola que recorre toda la API pública de
    Rodaje.Core compilado de antemano a código nativo. Si el núcleo usara reflexión o JSON sin
    generador de código, el análisis de recorte/AOT daría una advertencia y, con
    TreatWarningsAsErrors, la publicación fallaría. Se publica con build\publicar-aot-prueba.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rodaje.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- No es un proyecto de pruebas: dotnet test sobre la solución lo compila pero no lo ejecuta -->
    <IsTestProject>false</IsTestProject>

    <!-- RID fijo: así packages.lock.json (que incluye los paquetes del compilador AOT) es estable -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Una advertencia por cada problema, no una sola agrupada por ensamblado -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Igual que se publicará el editor: sin datos de ICU, las fechas y números en cultura invariable -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!-- La consola de prueba no necesita las reglas de nombres ni de localización del núcleo -->
    <NoWarn>$(NoWarn);CA1303;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rodaje.Core\Rodaje.Core.csproj" />
    <!-- Tildes y orden alfabético de los paquetes, que sin ICU no pueden depender de Normalize ni de la cultura -->
    <ProjectReference Include="..\..\src\Rodaje.Packages\Rodaje.Packages.csproj" />
  </ItemGroup>

</Project>
