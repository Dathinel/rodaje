<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de la lógica de la app que no depende de WinUI: compila aquí los fuentes de src\Rodaje.App\Services, de
    src\Rodaje.App\Views\Timeline\Logic, de src\Rodaje.App\Views\Export\Logic, de src\Rodaje.App\Views\Player\Logic y de src\Rodaje.App\Views\Analysis\Logic, que por contrato no usan WinUI (si alguno lo hiciera, este proyecto dejaría de compilar).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsPackable>false</IsPackable>
    <RootNamespace>Rodaje.App.Tests</RootNamespace>
    <!-- Services/Modules usa P/Invoke de TerraFX (Job Object). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Pool de hilos con un mínimo de 32. Las pruebas de este proyecto corren cuatro clases a la vez y muchas dejan hilos del
    pool bloqueados (esperas de procesos, módulos, ffmpeg) o encadenando trabajo en su cola local; en la CI de Windows, con
    el mínimo de 4, el pool se quedó en 9 o 10 hilos y un trabajo de la cola global esperó más de 2 minutos
    («Pool: 9 hilos (mínimo 4), 1 trabajos en cola»): el ping de un módulo sano no llegaba a tiempo y se daba por colgado,
    y las pruebas del hilo de interfaz agotaban su tope. Con el mínimo alto, un trabajo nuevo despierta un hilo enseguida.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.MinThreads" Value="32" />
  </ItemGroup>

  <ItemGroup>
    <!-- Corredor y mutaciones del fuzz de archivos, compartidos con las pruebas del núcleo y de paquetes -->
    <Compile Include="..\Rodaje.Core.Tests\Fuzz\FuzzRunner.cs" Link="Fuzz\FuzzRunner.cs" />
    <Compile Include="..\Rodaje.Packages.Tests\Fuzz\ContentReaderFuzz.cs" Link="Fuzz\ContentReaderFuzz.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Rodaje.App\Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Completa un método parcial de Shell (EditorServices.cs), que las pruebas no compilan. -->
    <Compile Remove="..\..\src\Rodaje.App\Services\Effects\EffectContentFactory.cs" />
    <EmbeddedResource Include="..\..\src\Rodaje.App\Services\Packages\catalogo.json" LogicalName="Rodaje.App.catalogo.json" Link="Services\Packages\catalogo.json" />
    <EmbeddedResource Include="..\..\src\Rodaje.App\Services\SafeZones\Fabrica\*.json" LogicalName="Rodaje.App.zonas.%(Filename).json" Link="Services\SafeZones\Fabrica\%(Filename).json" />
    <Compile Include="..\..\src\Rodaje.App\Views\Timeline\Logic\**\*.cs" Link="Timeline\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Rodaje.App\Views\Export\Logic\**\*.cs" Link="ExportLogic\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Rodaje.App\Views\Player\Logic\**\*.cs" Link="PlayerLogic\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Estabilizar y color automático: la caché de análisis y las ediciones, sin WinUI. -->
    <Compile Include="..\..\src\Rodaje.App\Views\Analysis\StabilizationStore.cs" Link="Analysis\StabilizationStore.cs" />
    <Compile Include="..\..\src\Rodaje.App\Views\Analysis\VideoAnalysisEdits.cs" Link="Analysis\VideoAnalysisEdits.cs" />
    <!-- La matriz de formatos corre los análisis con la misma decodificación que la app. -->
    <Compile Include="..\..\src\Rodaje.App\Views\Analysis\ClipVideoSource.cs" Link="Analysis\ClipVideoSource.cs" />
    <Compile Include="..\..\src\Rodaje.App\Views\Analysis\ClipAudioSource.cs" Link="Analysis\ClipAudioSource.cs" />
    <Compile Include="..\..\src\Rodaje.App\Views\Analysis\Logic\**\*.cs" Link="AnalysisLogic\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Subtítulos automáticos: leer el resultado del módulo, llevarlo a la secuencia y armar el paso, sin WinUI. -->
    <Compile Include="..\..\src\Rodaje.App\Views\Subtitles\Logic\**\*.cs" Link="SubtitlesLogic\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Biblioteca: carpetas, favoritos, búsqueda y datos de los medios, sin WinUI. -->
    <Compile Include="..\..\src\Rodaje.App\Views\Library\Logic\**\*.cs" Link="LibraryLogic\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Importar CinemaDNG con modulo-raw, sin WinUI. -->
    <Compile Include="..\..\src\Rodaje.App\Views\Raw\Logic\**\*.cs" Link="RawLogic\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Rodaje.App\Views\Vision\Logic\**\*.cs" Link="VisionLogic\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rodaje.Analysis\Rodaje.Analysis.csproj" />
    <ProjectReference Include="..\..\src\Rodaje.Engine\Rodaje.Engine.csproj" />
    <ProjectReference Include="..\..\src\Rodaje.Analysis\Rodaje.Analysis.csproj" />
    <ProjectReference Include="..\..\src\Rodaje.Export\Rodaje.Export.csproj" />
    <ProjectReference Include="..\..\src\Rodaje.Packages\Rodaje.Packages.csproj" />
    <!-- La prueba de punta a punta con los paquetes de contenido compone con el render real. -->
    <ProjectReference Include="..\..\src\Rodaje.Render\Rodaje.Render.csproj" />
    <ProjectReference Include="..\Rodaje.TestMedia\Rodaje.TestMedia.csproj" />
    <!-- Servidor HTTP local para bajar los modelos de un módulo instalado (Packages/ModuleInstallTests). -->
    <ProjectReference Include="..\Rodaje.TestServer\Rodaje.TestServer.csproj" />
    <ProjectReference Include="..\..\src\Rodaje.Modules.Protocol\Rodaje.Modules.Protocol.csproj" />
    <!-- Solo para que Rodaje.Module.Echo.exe quede junto a las pruebas de Modules/. -->
    <ProjectReference Include="..\..\modules\Rodaje.Module.Echo\Rodaje.Module.Echo.csproj" />
    <!-- Solo para que modulo-raw esté compilado en modules\ (las pruebas de Raw/ lo buscan ahí, como la app en desarrollo). -->
    <ProjectReference Include="..\..\modules\Rodaje.Module.Raw\Rodaje.Module.Raw.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
