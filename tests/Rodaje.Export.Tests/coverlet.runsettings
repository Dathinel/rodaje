<?xml version="1.0" encoding="utf-8"?>
<!-- Como el de Rodaje.Core.Tests: mide solo Rodaje.Export (fase 6, mínimo 90 % en herramientas\probar.ps1 -Cobertura). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Rodaje.Export]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/*.g.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
