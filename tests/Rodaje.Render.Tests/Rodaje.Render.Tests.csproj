<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Las pruebas de GPU se omiten con el motivo si no hay Direct3D 11 por hardware -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los casos de aceptación de títulos: DirectWrite escribe aquí la referencia que HarfBuzz compara en Linux y macOS (D-066). -->
    <Compile Include="..\Rodaje.Text.Tests\TitleLayoutCases.cs" Link="Text\TitleLayoutCases.cs" />
    <!-- Lo que todo motor de IGpu cumple igual: aquí con D3D11 (WARP), en Rodaje.Render.Vulkan.Tests con Vulkan. -->
    <Compile Include="..\Rodaje.Render.Vulkan.Tests\Gpu\GpuEngineChecks.cs" Link="Gpu\GpuEngineChecks.cs" />
    <!-- VulkanTestGpu y [VulkanFact]/[VulkanTheory], compartidos con las pruebas del motor Vulkan. -->
    <Compile Include="..\Rodaje.Render.Vulkan.Tests\Gpu\VulkanFact.cs" Link="Gpu\VulkanFact.cs" />
    <EmbeddedResource Include="..\Rodaje.Render.Vulkan.Tests\Gpu\igpu-pruebas.hlsl" Link="Gpu\igpu-pruebas.hlsl" LogicalName="igpu-pruebas.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rodaje.Render\Rodaje.Render.csproj" />
    <ProjectReference Include="..\..\src\Rodaje.Analysis\Rodaje.Analysis.csproj" />
    <ProjectReference Include="..\Rodaje.TestMedia\Rodaje.TestMedia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
