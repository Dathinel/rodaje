<Project Sdk="Microsoft.NET.Sdk">

  <!--
    modulo-subtitulos: transcribe audio f32 de 16 kHz con Whisper (whisper.cpp vía Whisper.net, MIT) en la GPU
    por Vulkan o en la CPU, y devuelve segmentos y palabras con tiempos (DTW) e idioma. Licencias en LICENCIAS.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Los tres RID en RuntimeIdentifiers: el mismo lockfile en cualquier anfitrión; el ejecutable es del sistema que
         compila (D-066, fase 7). -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</RuntimeIdentifier>
    <RootNamespace>Rodaje.Module.Subtitles</RootNamespace>
    <AssemblyName>Rodaje.Module.Subtitles</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1303;CA1515;CA1716</NoWarn>
    <!-- IL3000 sale de Whisper.net (Assembly.Location al buscar sus DLL nativas); también busca junto al ejecutable,
         que es lo que vale con AOT. Lo comprueba la suite con RODAJE_MODULO_SUBTITULOS apuntando al publicado. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL3000</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ModelFiles.cs" Link="ModelFiles.cs" />
    <EmbeddedResource Include="paquete.json" LogicalName="Rodaje.Module.Models" />
    <InternalsVisibleTo Include="Rodaje.Module.Subtitles.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rodaje.Modules.Protocol\Rodaje.Modules.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

</Project>
