<Project Sdk="Microsoft.NET.Sdk">

  <!--
    modulo-vision: quitar el fondo (MODNet, BiRefNet_lite), detectar rostros (YuNet) y personas (RT-DETRv2) con
    ONNX Runtime, y reencuadre automático (código propio). DirectML si hay GPU, CPU si no. Los modelos no van en el repo:
    ver LICENCIAS.md y build\preparar-modelos.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>Rodaje.Module.Vision</RootNamespace>
    <AssemblyName>Rodaje.Module.Vision</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1303;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rodaje.Module.Vision.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rodaje.Modules.Protocol\Rodaje.Modules.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>

</Project>
