<Project Sdk="Microsoft.NET.Sdk">

  <!--
    modulo-audio-ia (fase 7 I): reducción de ruido de voz (DeepFilterNet3) y detección de voz (Silero VAD) con ONNX
    Runtime. DirectML si hay GPU, CPU si no. Los modelos no van en el repo: ver LICENCIAS.md y build\preparar-modelos.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>Rodaje.Module.AudioAi</RootNamespace>
    <AssemblyName>Rodaje.Module.AudioAi</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1303;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rodaje.Module.AudioAi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rodaje.Modules.Protocol\Rodaje.Modules.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>

</Project>
