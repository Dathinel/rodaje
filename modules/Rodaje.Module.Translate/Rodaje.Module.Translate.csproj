<Project Sdk="Microsoft.NET.Sdk">

  <!--
    modulo-traducir: traduce los textos de una pista de subtítulos conservando sus ids, con
    Qwen3-4B-Instruct-2507 Q4_K_M (Apache-2.0) en llama.cpp vía LLamaSharp (MIT): Vulkan con las capas que quepan y la
    CPU de respaldo. El modelo no va en el repo: build\preparar-modelos.ps1 -Traductor. Licencias en LICENCIAS.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- RID fijo: el lockfile no depende del anfitrión que restaura (NU1004). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>Rodaje.Module.Translate</RootNamespace>
    <AssemblyName>Rodaje.Module.Translate</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- LLamaSharp no declara soporte de AOT: el módulo sale autocontenido con JIT (D-031). -->
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1303;CA1515;CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rodaje.Module.Translate.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rodaje.Modules.Protocol\Rodaje.Modules.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <!-- Solo la variante de Windows: LLamaSharp.Backend.Vulkan trae también la de Linux. -->
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" Version="0.27.0" />
  </ItemGroup>

</Project>
