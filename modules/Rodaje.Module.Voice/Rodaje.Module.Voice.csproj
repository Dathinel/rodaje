<Project Sdk="Microsoft.NET.Sdk">

  <!--
    modulo-voz (fase 7): texto a voz con Kokoro-82M (Apache-2.0) en ONNX Runtime CPU. Fonemizador propio para español
    y portugués de Brasil y léxico misaki (Apache-2.0) para inglés; espeak-ng (GPL) no se usa. Licencias en LICENCIAS.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Rodaje.Module.Voice</RootNamespace>
    <AssemblyName>Rodaje.Module.Voice</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1303;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rodaje.Module.Voice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rodaje.Modules.Protocol\Rodaje.Modules.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

</Project>
