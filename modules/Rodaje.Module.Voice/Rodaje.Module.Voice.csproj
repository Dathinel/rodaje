<Project Sdk="Microsoft.NET.Sdk">

  <!--
    modulo-voz: texto a voz con Kokoro-82M (Apache-2.0) en ONNX Runtime CPU. Fonemizador propio para español
    y portugués de Brasil y léxico misaki (Apache-2.0) para inglés; espeak-ng (GPL) no se usa. Licencias en LICENCIAS.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Los tres RID en RuntimeIdentifiers: el mismo lockfile en cualquier anfitrión; el ejecutable es del sistema que
         compila (D-066, fase 7). -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</RuntimeIdentifier>
    <RootNamespace>Rodaje.Module.Voice</RootNamespace>
    <AssemblyName>Rodaje.Module.Voice</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1303;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ModelFiles.cs" Link="ModelFiles.cs" />
    <EmbeddedResource Include="paquete.json" LogicalName="Rodaje.Module.Models" />
    <InternalsVisibleTo Include="Rodaje.Module.Voice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rodaje.Modules.Protocol\Rodaje.Modules.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

</Project>
