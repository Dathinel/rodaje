<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Módulo de ejemplo del protocolo: responde, informa avance, se cancela, copia búferes de memoria compartida
    y sabe morir o colgarse para las pruebas. Plantilla para los módulos reales (modulo-*).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- RID fijo: con PublishAot y sin RID el SDK toma el del anfitrión (linux-x64 en la CI) y el lockfile cambia -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>Rodaje.Module.Echo</RootNamespace>
    <AssemblyName>Rodaje.Module.Echo</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1303;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rodaje.Modules.Protocol\Rodaje.Modules.Protocol.csproj" />
  </ItemGroup>

</Project>
