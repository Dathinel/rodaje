<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Módulo de ejemplo del protocolo: responde, informa avance, se cancela, copia búferes de memoria compartida
    y sabe morir o colgarse para las pruebas. Plantilla para los módulos reales (modulo-*).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Los tres RID en RuntimeIdentifiers: el lockfile es el mismo en cualquier anfitrión y con o sin «-r»; el RID del
         ejecutable es el del sistema que compila (las pruebas del protocolo lo lanzan en Linux y macOS). -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</RuntimeIdentifier>
    <RootNamespace>Rodaje.Module.Echo</RootNamespace>
    <AssemblyName>Rodaje.Module.Echo</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1303;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rodaje.Modules.Protocol\Rodaje.Modules.Protocol.csproj" />
  </ItemGroup>

</Project>
