<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sondeo técnico de la fase 2: qué interop nativa compila con Native AOT sin advertencias y funciona.
    No forma parte de Rodaje.slnx. Variantes (-p:Variante=...):
      Cargado  : FFmpeg.AutoGen.Bindings.DynamicallyLoaded (punteros a función resueltos con GetProcAddress)
      Enlazado : FFmpeg.AutoGen.Bindings.DynamicallyLinked (DllImport)
      AutoGen  : paquete FFmpeg.AutoGen todo en uno (delegados)
      NAudio   : como Cargado, más NAudio.Wasapi para medir sus advertencias
    y, para Direct3D 11 y XAudio2 (-p:Graficos=...):
      Vortice  : Vortice.Direct3D11/DXGI/XAudio2 (SharpGen.Runtime)
      TerraFX  : TerraFX.Interop.Windows (structs con punteros a función, sin runtime propio)
    Se publica y mide con sondear.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>AotInterop</AssemblyName>
    <RootNamespace>AotInterop</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- obj\ y bin\ tienen una subcarpeta por variante: que ninguna compile los .cs generados de otra -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
    <NuGetLockFilePath>packages.$(Sabor).lock.json</NuGetLockFilePath>
    <DefineConstants>$(DefineConstants);VARIANTE_$(Variante.ToUpperInvariant())</DefineConstants>
    <DefineConstants>$(DefineConstants);GRAFICOS_$(Graficos.ToUpperInvariant())</DefineConstants>
    <NoWarn>$(NoWarn);CA1303;CA1515;CA1031;CA5392</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(Graficos)' == 'Vortice'">
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.XAudio2" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(Graficos)' == 'TerraFX'">
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
  </ItemGroup>

  <ItemGroup Condition="'$(Variante)' == 'Cargado' Or '$(Variante)' == 'NAudio'">
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="9.0.1.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(Variante)' == 'Enlazado'">
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLinked" Version="9.0.1.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(Variante)' == 'AutoGen'">
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(Variante)' == 'NAudio'">
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

</Project>
