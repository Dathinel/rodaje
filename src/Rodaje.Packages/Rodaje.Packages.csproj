<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Formato .paquete (docs/formato-paquete.md): manifiesto, cargador, instalador y catálogo. Sin dependencias ni WinUI,
    para que otros programas de Dathinel lo compartan cuando salga a su propio repositorio.
  -->
  <PropertyGroup>
    <RootNamespace>Rodaje.Packages</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- También en Debug: el lector de .cube tiene que leer 65³ en 150 ms o menos en las pruebas. -->
    <Optimize>true</Optimize>
    <!-- CreateHardLinkW (ModelStore): el generador de LibraryImport fija las cadenas con punteros. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rodaje.Packages.Tests" />
  </ItemGroup>

</Project>
