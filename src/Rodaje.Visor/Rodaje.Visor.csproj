<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Visor de prueba de la fase 3: una ventana Win32 que reproduce una secuencia de varias capas con el motor real
    (TimelineSession, Compositor y Presenter). Se publica con herramientas\visor.ps1; en la fase 4 lo reemplaza WinUI 3.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Rodaje.Visor</RootNamespace>
    <AssemblyName>Rodaje.Visor</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- RID fijo: así packages.lock.json (que incluye los paquetes del compilador AOT) es estable -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rodaje.Visor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rodaje.Engine\Rodaje.Engine.csproj" />
    <ProjectReference Include="..\Rodaje.Render\Rodaje.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
  </ItemGroup>

</Project>
