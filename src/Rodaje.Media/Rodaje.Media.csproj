<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Rodaje.Media</RootNamespace>
    <!-- Demultiplexado y decodificación con FFmpeg (LGPL, cargado por ruta absoluta) y Direct3D 11 -->
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rodaje.Media.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rodaje.Core\Rodaje.Core.csproj" />
    <ProjectReference Include="..\Rodaje.Playback\Rodaje.Playback.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLinked" Version="9.0.1.1" />
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
  </ItemGroup>

</Project>
