<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rodaje.Playback</RootNamespace>
    <!-- Lógica de reproducción sin dependencias de plataforma: ni FFmpeg ni dispositivos de audio -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rodaje.Playback.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rodaje.Core\Rodaje.Core.csproj" />
  </ItemGroup>

</Project>
