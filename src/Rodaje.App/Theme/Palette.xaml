<?xml version="1.0" encoding="utf-8"?>
<!--
    Paleta grafito de la maqueta aprobada (D-018). Las vistas usan solo estas claves (StaticResource), nunca colores
    sueltos. Debajo, los diccionarios de tema: Default, Light y Dark llevan la paleta a los controles de WinUI (ControlColors.xaml);
    en el contraste alto real, WinUI y ThemeResources usan los colores del sistema.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#101010</Color>
    <Color x:Key="BarColor">#262626</Color>
    <Color x:Key="PanelColor">#1D1D1D</Color>
    <!-- Alrededor del lienzo en el visor: el render limpia con este color (PlayerEngine.SurroundColor) y pinta la imagen en negro encima. -->
    <Color x:Key="ViewerSurroundColor">#242424</Color>
    <Color x:Key="ControlColor">#2C2C2C</Color>
    <Color x:Key="ControlHoverColor">#3A3A3A</Color>
    <Color x:Key="ControlPressedColor">#4A4A4A</Color>
    <Color x:Key="StrokeColor">#3A3A3A</Color>
    <!-- Borde de campos, botones y desplegables: 3:1 contra el panel (WCAG AA para controles). -->
    <Color x:Key="ControlBorderColor">#737373</Color>
    <Color x:Key="TextColor">#ECECEC</Color>
    <Color x:Key="TextMutedColor">#B0B0B0</Color>
    <Color x:Key="TextDisabledColor">#7A7A7A</Color>
    <Color x:Key="AccentColor">#E8833A</Color>
    <Color x:Key="AccentHoverColor">#EE9A5C</Color>
    <Color x:Key="AccentPressedColor">#C96D29</Color>
    <Color x:Key="AccentSubtleColor">#4DE8833A</Color>
    <!-- Texto sobre el naranja lleno (botón principal): 6,8:1. Sobre AccentSubtle el naranja da 3,7:1: ahí va TextBrush. -->
    <Color x:Key="AccentForegroundColor">#141414</Color>
    <Color x:Key="VideoClipColor">#33587C</Color>
    <Color x:Key="VideoClipEdgeColor">#7FB0DE</Color>
    <Color x:Key="TextClipColor">#574573</Color>
    <Color x:Key="TextClipEdgeColor">#B7A2E3</Color>
    <Color x:Key="AudioClipColor">#365A31</Color>
    <Color x:Key="AudioClipEdgeColor">#9BCB83</Color>
    <Color x:Key="KeyframeColor">#F2D16B</Color>
    <Color x:Key="MeterLowColor">#7FB069</Color>
    <Color x:Key="MeterMidColor">#F2D16B</Color>
    <Color x:Key="MeterHighColor">#E5534B</Color>
    <Color x:Key="ScrimColor">#B3000000</Color>
    <!-- Encima del video: sombra del recorte y zonas seguras (contorno y texto claros sobre cualquier imagen). -->
    <Color x:Key="ShadeColor">#99000000</Color>
    <Color x:Key="SafeZoneFillColor">#70000000</Color>
    <Color x:Key="SafeZoneStrokeColor">#B0FFFFFF</Color>
    <Color x:Key="SafeZoneTextColor">#F2F2F2</Color>
    <Color x:Key="SafeZoneNoteColor">#C01A1A1A</Color>
    <!-- Marcas de los análisis (silencios, ritmo, voz, subtítulos): de la misma familia que clips y medidores. -->
    <Color x:Key="CutMarkColor">#E5534B</Color>
    <Color x:Key="BeatMarkColor">#F2B134</Color>
    <Color x:Key="VoiceMarkColor">#7FB0DE</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BarBrush" Color="{StaticResource BarColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="ViewerSurroundBrush" Color="{StaticResource ViewerSurroundColor}" />
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="VideoClipBrush" Color="{StaticResource VideoClipColor}" />
    <SolidColorBrush x:Key="VideoClipEdgeBrush" Color="{StaticResource VideoClipEdgeColor}" />
    <SolidColorBrush x:Key="TextClipBrush" Color="{StaticResource TextClipColor}" />
    <SolidColorBrush x:Key="TextClipEdgeBrush" Color="{StaticResource TextClipEdgeColor}" />
    <SolidColorBrush x:Key="AudioClipBrush" Color="{StaticResource AudioClipColor}" />
    <SolidColorBrush x:Key="AudioClipEdgeBrush" Color="{StaticResource AudioClipEdgeColor}" />
    <SolidColorBrush x:Key="KeyframeBrush" Color="{StaticResource KeyframeColor}" />
    <SolidColorBrush x:Key="MeterLowBrush" Color="{StaticResource MeterLowColor}" />
    <SolidColorBrush x:Key="MeterMidBrush" Color="{StaticResource MeterMidColor}" />
    <SolidColorBrush x:Key="MeterHighBrush" Color="{StaticResource MeterHighColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="ShadeBrush" Color="{StaticResource ShadeColor}" />
    <SolidColorBrush x:Key="SafeZoneFillBrush" Color="{StaticResource SafeZoneFillColor}" />
    <SolidColorBrush x:Key="SafeZoneStrokeBrush" Color="{StaticResource SafeZoneStrokeColor}" />
    <SolidColorBrush x:Key="SafeZoneTextBrush" Color="{StaticResource SafeZoneTextColor}" />
    <SolidColorBrush x:Key="SafeZoneNoteBrush" Color="{StaticResource SafeZoneNoteColor}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!--
        Esquinas casi rectas (2 px) en controles, tarjetas y paneles flotantes; los círculos (asas) son la única excepción.
        Bordes de 1 px. Espaciado en la rejilla de 4 px (4, 8, 12, 16, 24); 1 y 2 solo para trazos y ajustes finos.
    -->
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="RodajeCornerRadius">2</CornerRadius>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default" Source="ms-appx:///Theme/ControlColors.xaml" />
        <ResourceDictionary x:Key="Light" Source="ms-appx:///Theme/ControlColors.xaml" />
        <ResourceDictionary x:Key="Dark" Source="ms-appx:///Theme/ControlColors.xaml" />
        <!-- Contraste alto real de Windows: sin acento propio; WinUI da sus controles en los colores del sistema. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorHotlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
