<?xml version="1.0" encoding="utf-8"?>
<!--
    Tipografía: Segoe UI Variable en tamaños de herramienta y Consolas para los códigos de tiempo. Las vistas usan solo
    estas claves. Texto: 10 (micro: regla, insignias, columnas), 11 (pie), 12 (cuerpo), 13 (título), 14 (cabecera), 20
    (subtítulo) y 28 (portada). Pesos: normal y SemiBold, nada más. Íconos (Segoe Fluent): 10, 14, 16 y 24.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Theme/Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <x:Double x:Key="MicroFontSize">10</x:Double>
    <x:Double x:Key="CaptionFontSize">11</x:Double>
    <x:Double x:Key="BodyFontSize">12</x:Double>
    <x:Double x:Key="TitleFontSize">13</x:Double>
    <x:Double x:Key="HeaderFontSize">14</x:Double>
    <x:Double x:Key="SubtitleFontSize">20</x:Double>
    <x:Double x:Key="DisplayFontSize">28</x:Double>
    <x:Double x:Key="IconSmallFontSize">10</x:Double>
    <x:Double x:Key="IconFontSize">14</x:Double>
    <x:Double x:Key="IconLargeFontSize">16</x:Double>
    <x:Double x:Key="IconHeroFontSize">24</x:Double>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="LabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
    </Style>

    <Style x:Key="MicroTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource MicroFontSize}" />
    </Style>

    <Style x:Key="PanelTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="HeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource HeaderFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TimecodeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="PlaceholderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
</ResourceDictionary>
