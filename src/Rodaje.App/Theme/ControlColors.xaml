    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#E8833A" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#ECECEC" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#ECECEC" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#B0B0B0" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#7A7A7A" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#232323" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#ECECEC" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#B0B0B0" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#7A7A7A" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#232323" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#4A4A4A" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#8C8C8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#B0B0B0" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#2C2C2C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#3A3A3A" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" Color="#5C5C5C" />
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="#7A7A7A" />
    <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="#7A7A7A" />
    <SolidColorBrush x:Key="ListViewItemForeground" Color="#ECECEC" />
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#ECECEC" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#7A7A7A" />
    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#5C5C5C" />
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#6E6E6E" />
</ResourceDictionary>
