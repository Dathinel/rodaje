<?xml version="1.0" encoding="utf-8"?>
<!--
    Las claves de WinUI redefinidas con la paleta grafito y el acento naranja, para que los controles de fábrica la tomen.
    Palette.xaml las usa para los temas Default, Light y Dark: fuera del contraste alto la app nunca muestra el acento
    del sistema.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="SystemAccentColor">#E8833A</Color>
    <Color x:Key="SystemAccentColorLight1">#EE9A5C</Color>
    <Color x:Key="SystemAccentColorLight2">#F2B080</Color>
    <Color x:Key="SystemAccentColorLight3">#F6C7A4</Color>
    <Color x:Key="SystemAccentColorDark1">#C96D29</Color>
    <Color x:Key="SystemAccentColorDark2">#A85A20</Color>
    <Color x:Key="SystemAccentColorDark3">#874818</Color>

    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#101010" />

    <SolidColorBrush x:Key="ButtonBackground" Color="#2C2C2C" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#ECECEC" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#7A7A7A" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#737373" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#8C8C8C" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#A0A0A0" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#3A3A3A" />

    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#2C2C2C" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#4DE8833A" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#66E8833A" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#80E8833A" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E8833A" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#EE9A5C" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E8833A" />

    <SolidColorBrush x:Key="SliderTrackFill" Color="#6E6E6E" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#808080" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#808080" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#E8833A" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#EE9A5C" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#C96D29" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#E8833A" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#EE9A5C" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#C96D29" />
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#2C2C2C" />

    <SolidColorBrush x:Key="ComboBoxBackground" Color="#2C2C2C" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#737373" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#8C8C8C" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#262626" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#5C5C5C" />

    <SolidColorBrush x:Key="TextControlBackground" Color="#2C2C2C" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#141414" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#737373" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#8C8C8C" />

    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#262626" />
