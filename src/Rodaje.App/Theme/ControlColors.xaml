    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#4A4A4A" />

    <SolidColorBrush x:Key="ToolTipBackground" Color="#2C2C2C" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#737373" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#ECECEC" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="#262626" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#262626" />
