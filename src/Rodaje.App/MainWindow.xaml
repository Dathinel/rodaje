<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rodaje.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rodaje">

    <!-- Esqueleto de la distribución D-018: riel y biblioteca, reproductor, propiedades y línea de tiempo -->
    <Grid x:Name="Root" Background="{StaticResource FondoBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="1" />
            <RowDefinition Height="280" />
        </Grid.RowDefinitions>

        <!-- Barra de título propia: nombre, menú, zona de arrastre y EXPORTAR -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource FondoBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInset" Width="138" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="14,0,8,0" Text="Rodaje" FontWeight="SemiBold" FontSize="13"
                       Foreground="{StaticResource AcentoBrush}" VerticalAlignment="Center" />
            <MenuBar Grid.Column="1" VerticalAlignment="Center">
                <MenuBarItem Title="Archivo">
                    <MenuFlyoutItem Text="Nuevo proyecto" />
                    <MenuFlyoutItem Text="Abrir..." />
                    <MenuFlyoutItem Text="Guardar" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exportar..." />
                </MenuBarItem>
                <MenuBarItem Title="Editar">
                    <MenuFlyoutItem Text="Deshacer" />
                    <MenuFlyoutItem Text="Rehacer" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Atajos de teclado..." />
                </MenuBarItem>
                <MenuBarItem Title="Ver">
                    <MenuFlyoutItem Text="Historial" />
                    <MenuFlyoutItem Text="Trabajos" />
                    <MenuFlyoutItem Text="Medidores de audio" />
                </MenuBarItem>
                <MenuBarItem Title="Complementos">
                    <MenuFlyoutItem Text="Gestor de complementos..." />
                </MenuBarItem>
                <MenuBarItem Title="Ayuda">
                    <MenuFlyoutItem Text="Acerca de Rodaje" />
                </MenuBarItem>
            </MenuBar>
            <Border x:Name="DragArea" Grid.Column="2" Background="Transparent">
                <TextBlock Text="{x:Bind State.ProjectName, Mode=OneWay}" Style="{StaticResource Etiqueta}" HorizontalAlignment="Center" />
            </Border>
            <Button x:Name="ExportButton" Grid.Column="3" Content="EXPORTAR" Margin="0,0,10,0" Height="28" Padding="16,0"
                    FontSize="12" FontWeight="SemiBold" Style="{StaticResource AccentButtonStyle}" Click="{x:Bind OnExport}" />
        </Grid>

        <!-- Zona central -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Riel de íconos -->
            <Border Grid.Column="0" Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,1,1,0">
                <StackPanel>
                    <Button Style="{StaticResource RielBoton}" ToolTipService.ToolTip="Medios"><FontIcon Glyph="&#xE714;" FontSize="16" Foreground="{StaticResource AcentoBrush}" /></Button>
                    <Button Style="{StaticResource RielBoton}" ToolTipService.ToolTip="Audio"><FontIcon Glyph="&#xE8D6;" FontSize="16" /></Button>
                    <Button Style="{StaticResource RielBoton}" ToolTipService.ToolTip="Texto"><FontIcon Glyph="&#xE8D2;" FontSize="16" /></Button>
                    <Button Style="{StaticResource RielBoton}" ToolTipService.ToolTip="Stickers"><FontIcon Glyph="&#xE76E;" FontSize="16" /></Button>
                    <Button Style="{StaticResource RielBoton}" ToolTipService.ToolTip="Efectos"><FontIcon Glyph="&#xE790;" FontSize="16" /></Button>
                    <Button Style="{StaticResource RielBoton}" ToolTipService.ToolTip="Transiciones"><FontIcon Glyph="&#xE8AB;" FontSize="16" /></Button>
                    <Button Style="{StaticResource RielBoton}" ToolTipService.ToolTip="Filtros"><FontIcon Glyph="&#xE71C;" FontSize="16" /></Button>
                    <Button Style="{StaticResource RielBoton}" ToolTipService.ToolTip="Complementos"><FontIcon Glyph="&#xEA86;" FontSize="16" /></Button>
                </StackPanel>
            </Border>

            <!-- Biblioteca -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{StaticResource CabeceraBrush}" Padding="12,0">
                        <TextBlock Text="Medios" Style="{StaticResource PanelTitulo}" />
                        <Button Content="Importar" HorizontalAlignment="Right" Height="24" Padding="10,0" FontSize="12" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Padding="10">
                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="116" ItemHeight="86">
                            <Border Margin="3" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1" CornerRadius="2">
                                <TextBlock Text="{x:Bind State.MediaName, Mode=OneWay}" Style="{StaticResource Etiqueta}" FontSize="11" Margin="6" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Margin="3" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1" CornerRadius="2" />
                            <Border Margin="3" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1" CornerRadius="2" />
                            <Border Margin="3" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1" CornerRadius="2" />
                        </VariableSizedWrapGrid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Reproductor -->
            <Grid Grid.Column="2" Background="{StaticResource CabeceraBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,1,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <SwapChainPanel x:Name="VideoPanel" Grid.Row="0" Margin="8" />
                <TextBlock Grid.Row="0" Text="{x:Bind State.Status, Mode=OneWay}" Style="{StaticResource Etiqueta}"
                           Margin="16,12" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Grid Grid.Row="1" Padding="12,0" Background="{StaticResource PanelBrush}">
                    <TextBlock Text="{x:Bind State.Timecode, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource TextoBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <Button Style="{StaticResource HerramientaBoton}" Content="&#xE892;" ToolTipService.ToolTip="Cuadro anterior" />
                        <Button Style="{StaticResource HerramientaBoton}" Content="{x:Bind State.PlayGlyph, Mode=OneWay}" Click="{x:Bind OnPlayClicked}"
                                ToolTipService.ToolTip="Reproducir o pausar (Espacio)" Foreground="{StaticResource AcentoBrush}" />
                        <Button Style="{StaticResource HerramientaBoton}" Content="&#xE893;" ToolTipService.ToolTip="Cuadro siguiente" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                        <TextBlock Text="Ajustar" Style="{StaticResource Etiqueta}" />
                        <Button Style="{StaticResource HerramientaBoton}" Content="&#xE740;" ToolTipService.ToolTip="Pantalla completa" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Propiedades con pestañas -->
            <Border Grid.Column="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <SelectorBar Background="{StaticResource CabeceraBrush}">
                        <SelectorBarItem Text="Video" IsSelected="True" />
                        <SelectorBarItem Text="Audio" />
                        <SelectorBarItem Text="Velocidad" />
                        <SelectorBarItem Text="Animación" />
                    </SelectorBar>
                    <StackPanel Grid.Row="1" Padding="14" Spacing="10">
                        <TextBlock Text="Transformar" Style="{StaticResource PanelTitulo}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Escala" Style="{StaticResource Etiqueta}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="400" Value="100" />
                            <TextBlock Grid.Column="2" Text="◆" Foreground="{StaticResource TextoTenueBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="Keyframe" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Posición" Style="{StaticResource Etiqueta}" />
                            <Slider Grid.Column="1" Minimum="-1000" Maximum="1000" Value="0" />
                            <TextBlock Grid.Column="2" Text="◆" Foreground="{StaticResource AcentoBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Rotación" Style="{StaticResource Etiqueta}" />
                            <Slider Grid.Column="1" Minimum="-180" Maximum="180" Value="0" />
                            <TextBlock Grid.Column="2" Text="◆" Foreground="{StaticResource TextoTenueBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Opacidad" Style="{StaticResource Etiqueta}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="100" />
                            <TextBlock Grid.Column="2" Text="◆" Foreground="{StaticResource TextoTenueBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Button Content="Guardar como transición" HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Rectangle Grid.Row="2" Fill="{StaticResource BordeBrush}" />

        <!-- Línea de tiempo: barra estilo Vegas y pistas de muestra -->
        <Grid Grid.Row="3" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Background="{StaticResource CabeceraBrush}" Padding="8,0" Spacing="2">
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE7A7;" ToolTipService.ToolTip="Deshacer" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE7A6;" ToolTipService.ToolTip="Rehacer" />
                <Rectangle Width="1" Height="18" Margin="6,0" Fill="{StaticResource BordeBrush}" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE8B0;" ToolTipService.ToolTip="Herramienta normal" Foreground="{StaticResource AcentoBrush}" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE9D2;" ToolTipService.ToolTip="Herramienta de envolvente" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE8B3;" ToolTipService.ToolTip="Herramienta de selección" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE71E;" ToolTipService.ToolTip="Herramienta de zoom" />
                <Rectangle Width="1" Height="18" Margin="6,0" Fill="{StaticResource BordeBrush}" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE840;" ToolTipService.ToolTip="Ajuste" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE8AB;" ToolTipService.ToolTip="Ripple automático" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE8EB;" ToolTipService.ToolTip="Fundido cruzado automático" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE72E;" ToolTipService.ToolTip="Bloquear envolventes" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE71B;" ToolTipService.ToolTip="Ignorar grupos" />
                <Rectangle Width="1" Height="18" Margin="6,0" Fill="{StaticResource BordeBrush}" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE8C6;" ToolTipService.ToolTip="Cortar en el cursor" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE892;" ToolTipService.ToolTip="Recortar inicio" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE893;" ToolTipService.ToolTip="Recortar final" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE7C1;" ToolTipService.ToolTip="Marcador" />
                <Button Style="{StaticResource HerramientaBoton}" Content="&#xE7C8;" ToolTipService.ToolTip="Región" />
                <Rectangle Width="1" Height="18" Margin="6,0" Fill="{StaticResource BordeBrush}" />
                <ToggleSwitch OnContent="Pista principal magnética" OffContent="Pista principal magnética" IsOn="True" FontSize="12" MinWidth="0" />
            </StackPanel>

            <!-- Regla -->
            <Border Grid.Row="1" Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,0,0,1" />

            <!-- Pistas -->
            <Grid Grid.Row="2" Padding="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" Padding="10,0">
                    <TextBlock Text="V2" Height="44" Style="{StaticResource Etiqueta}" />
                    <TextBlock Text="V1 principal" Height="56" Style="{StaticResource Etiqueta}" />
                    <TextBlock Text="A1" Height="44" Style="{StaticResource Etiqueta}" />
                </StackPanel>
                <Canvas x:Name="TracksCanvas" Grid.Column="1" SizeChanged="OnTracksSizeChanged">
                    <Border Canvas.Left="200" Canvas.Top="0" Width="180" Height="44" Background="#3A4A63" BorderBrush="#5A6E8E" BorderThickness="1" CornerRadius="2" />
                    <Border x:Name="MainClip" Canvas.Left="0" Canvas.Top="48" Width="600" Height="56" Background="#2F5560" BorderBrush="#4D8090" BorderThickness="1" CornerRadius="2">
                        <TextBlock Text="{x:Bind State.MediaName, Mode=OneWay}" FontSize="11" Margin="6,4" Foreground="{StaticResource TextoBrush}" />
                    </Border>
                    <Border x:Name="AudioClip" Canvas.Left="0" Canvas.Top="108" Width="600" Height="44" Background="#2E5A3A" BorderBrush="#4C8A5E" BorderThickness="1" CornerRadius="2" />
                    <Rectangle x:Name="Playhead" Width="2" Height="160" Fill="{StaticResource AcentoBrush}">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="PlayheadOffset" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Grid>
        </Grid>
    </Grid>
</Window>
