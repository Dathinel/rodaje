<?xml version="1.0" encoding="utf-8"?>
<!--
    Riel de categorías y biblioteca. Medios y Audio: los medios del proyecto con portada real (IClipVisuals), importar,
    soltar archivos, doble clic para añadir a la pista principal, arrastrar a la línea de tiempo (rodaje/media-id) y menú
    contextual. Medios además tiene carpetas (soltar medios en una ficha los mueve), búsqueda, filtro por tipo, favoritos
    y una lista con la columna de datos (resolución, duración, fps y códec); la lógica está en Logic/. Texto, Efectos, Transiciones y Filtros: lo del motor, lo de los paquetes instalados y lo propio
    (rodaje/elemento; las transiciones también rodaje/transicion); doble clic o el menú los aplican al clip
    seleccionado. IA: los módulos y si están instalados. Marcadores: la lista de marcadores de la secuencia (MarkersPanel).
-->
<UserControl
    x:Class="Rodaje.App.Views.Library.LibraryView"
    xmlns:shell="using:Rodaje.App.Shell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rodaje.App.Views.Library"
    xmlns:markers="using:Rodaje.App.Views.Markers">

    <UserControl.Resources>
        <DataTemplate x:Key="MediaTileTemplate" x:DataType="local:MediaItem">
            <Grid Width="118" Height="112" ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}" Opacity="{x:Bind TileOpacity, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Pasar el ratón recorre el medio (skimming); al salir vuelve la portada. -->
                <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}"
                        PointerMoved="OnTilePointerMoved" PointerExited="OnTilePointerExited">
                    <Grid>
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="{StaticResource IconHeroFontSize}" Foreground="{StaticResource TextMutedBrush}" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind Displayed, Mode=OneWay}" Stretch="UniformToFill" />
                        <Border Background="{StaticResource ScrimBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="4,1" Margin="4"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{x:Bind SubclipVisibility}">
                            <TextBlock Text="Subclip" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource MicroFontSize}" />
                        </Border>
                        <Border Background="{StaticResource DangerBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="4,1" Margin="4"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{x:Bind OfflineVisibility, Mode=OneWay}">
                            <TextBlock Text="Sin conexión" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource MicroFontSize}" />
                        </Border>
                        <Border Background="{StaticResource ScrimBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="4,1" Margin="4,4,4,22"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{x:Bind DuplicateVisibility, Mode=OneWay}">
                            <TextBlock Text="Repetido" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource MicroFontSize}" />
                        </Border>
                        <FontIcon Glyph="&#xE711;" FontSize="{StaticResource IconHeroFontSize}" Foreground="{StaticResource DangerBrush}" Visibility="{x:Bind RejectedVisibility, Mode=OneWay}" />
                        <Border Background="{StaticResource ScrimBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="4,1" Margin="4"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{x:Bind BadgeVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Badge, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource MicroFontSize}" />
                        </Border>
                        <Border Background="{StaticResource ScrimBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="4,1" Margin="4"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind DurationText}" Style="{StaticResource TimecodeTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                        </Border>
                        <Border Background="{StaticResource ScrimBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="4" Margin="4"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{x:Bind FavoriteVisibility, Mode=OneWay}">
                            <FontIcon Glyph="&#xE735;" FontSize="{StaticResource IconSmallFontSize}" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Padding="2,4,2,0">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" FontSize="{StaticResource CaptionFontSize}" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                    <TextBlock Text="{x:Bind RatingText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource MicroFontSize}" Visibility="{x:Bind RatingVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Fila de la lista: nombre y, debajo, la columna de datos con los mismos anchos que la cabecera. -->
        <DataTemplate x:Key="MediaRowTemplate" x:DataType="local:MediaItem">
            <Grid Padding="0,4" RowSpacing="2" ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="{StaticResource IconFontSize}" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" FontSize="{StaticResource CaptionFontSize}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{x:Bind RatingText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource MicroFontSize}" VerticalAlignment="Center" Visibility="{x:Bind RatingVisibility, Mode=OneWay}" />
                    <TextBlock Text="Sin conexión" Foreground="{StaticResource DangerBrush}" FontSize="{StaticResource MicroFontSize}" VerticalAlignment="Center" Visibility="{x:Bind OfflineVisibility, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource IconSmallFontSize}" Foreground="{StaticResource DangerBrush}" Visibility="{x:Bind RejectedVisibility, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE735;" FontSize="{StaticResource IconSmallFontSize}" Foreground="{StaticResource AccentBrush}" Visibility="{x:Bind FavoriteVisibility, Mode=OneWay}" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="4" Opacity="{x:Bind TileOpacity, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ResolutionText}" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind FrameRateText}" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Codecs, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                    <TextBlock Grid.Column="4" Text="{x:Bind DateText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                    <TextBlock Grid.Column="5" Text="{x:Bind CameraText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                </Grid>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{x:Bind TagsText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}"
                           Foreground="{StaticResource AccentBrush}" Visibility="{x:Bind TagsVisibility, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FolderTileTemplate" x:DataType="local:FolderItem">
            <Grid Width="118" Height="40" Padding="8,4" ColumnSpacing="8" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource StrokeBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" ToolTipService.ToolTip="{x:Bind Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource IconFontSize}" Foreground="{StaticResource TextMutedBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" FontSize="{StaticResource CaptionFontSize}" />
                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ElementTileTemplate" x:DataType="local:ElementItem">
            <Grid Width="118" Height="64" Padding="8,8" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource StrokeBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Opacity="{x:Bind Opacity}" ToolTipService.ToolTip="{x:Bind Tooltip}" RowSpacing="2"
                  PointerEntered="OnElementPointerEntered" PointerExited="OnElementPointerExited">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Transiciones: miniatura compuesta en la GPU, animada al pasar el puntero; el nombre va sobre una sombra. -->
                <Image Grid.RowSpan="3" Margin="-8" Source="{x:Bind Preview, Mode=OneWay}" Stretch="UniformToFill" />
                <Rectangle Grid.Row="1" Grid.RowSpan="2" Margin="-8,-4,-8,-8" Visibility="{x:Bind PreviewShadeVisibility, Mode=OneWay}">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#C0000000" Offset="0.6" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="{StaticResource IconFontSize}" HorizontalAlignment="Left" Foreground="{StaticResource TextMutedBrush}"
                          Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                <TextBlock Grid.Row="1" Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" FontSize="{StaticResource CaptionFontSize}" />
                <TextBlock Grid.Row="2" Text="{x:Bind Source}" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SoundTileTemplate" x:DataType="local:ElementItem">
            <Grid Width="176" Height="64" Padding="8" ColumnSpacing="8" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource StrokeBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" ToolTipService.ToolTip="{x:Bind Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" FontSize="{StaticResource CaptionFontSize}" />
                    <TextBlock Text="{x:Bind Source}" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ToolButtonStyle}" Content="&#xE768;" Click="OnSoundPreviewClick" DoubleTapped="OnSoundPreviewDoubleTapped"
                        AutomationProperties.Name="Escuchar" ToolTipService.ToolTip="Escuchar o detener la preescucha" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <StackPanel>
                <RadioButton x:Name="MediaTab" Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Media" IsChecked="True" Checked="OnCategoryChecked" ToolTipService.ToolTip="Medios" AutomationProperties.Name="Medios" Content="&#xE714;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Audio" Checked="OnCategoryChecked" ToolTipService.ToolTip="Audio" AutomationProperties.Name="Audio" Content="&#xE8D6;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Text" Checked="OnCategoryChecked" ToolTipService.ToolTip="Texto" AutomationProperties.Name="Texto" Content="&#xE8D2;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Effects" Checked="OnCategoryChecked" ToolTipService.ToolTip="Efectos" AutomationProperties.Name="Efectos" Content="&#xE790;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Transitions" Checked="OnCategoryChecked" ToolTipService.ToolTip="Transiciones" AutomationProperties.Name="Transiciones" Content="&#xE8AB;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Filters" Checked="OnCategoryChecked" ToolTipService.ToolTip="Filtros" AutomationProperties.Name="Filtros" Content="&#xE71C;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Ai" Checked="OnCategoryChecked" ToolTipService.ToolTip="Módulos de IA" AutomationProperties.Name="Módulos de IA" Content="&#xE945;" />

            </StackPanel>
        </Border>

        <Grid Grid.Column="1" AllowDrop="True" DragOver="OnFilesDragOver" Drop="OnFilesDrop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Style="{StaticResource PanelHeaderStyle}" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CategoryTitle" Text="Medios" Style="{StaticResource PanelTitleTextStyle}" />
                <Button x:Name="ImportButton" Grid.Column="1" Content="Importar" Click="OnImportClick" ToolTipService.ToolTip="Importar videos o audios a la biblioteca" />
                <Button x:Name="NewFolderButton" Grid.Column="2" Style="{StaticResource ToolButtonStyle}" Content="&#xE8F4;" Click="OnNewFolderClick" AutomationProperties.Name="Nueva carpeta"
                        ToolTipService.ToolTip="Nueva carpeta en la biblioteca (no mueve archivos en el disco)" />
                <Button x:Name="PluginsButton" Grid.Column="3" Style="{StaticResource ToolButtonStyle}" Content="&#xEA86;" Click="OnPluginsClick" AutomationProperties.Name="Abrir complementos"
                        ToolTipService.ToolTip="Complementos: paquetes y módulos de IA" />
            </Grid>

            <Grid x:Name="MediaPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Buscar (en toda la biblioteca), tipo, solo favoritos y cuadrícula o lista con datos. -->
                <Grid Padding="8,8,8,0" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" MinWidth="0" Height="28" MinHeight="28" FontSize="{StaticResource BodyFontSize}" PlaceholderText="Buscar"
                             TextChanged="OnSearchChanged" AutomationProperties.Name="Buscar en la biblioteca"
                             ToolTipService.ToolTip="Busca por nombre, etiqueta, códec, resolución, fecha o cámara en todas las carpetas (sin mirar mayúsculas ni tildes)" />
                    <Button x:Name="KindButton" Grid.Column="1" Style="{StaticResource ToolButtonStyle}" Content="&#xE71C;" AutomationProperties.Name="Filtros y colecciones inteligentes"
                            ToolTipService.ToolTip="Filtros y colecciones inteligentes" />
                    <ToggleButton x:Name="FavoritesToggle" Grid.Column="2" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE734;" Click="OnFavoritesToggleClick"
                                  AutomationProperties.Name="Solo favoritos" ToolTipService.ToolTip="Solo favoritos (de todas las carpetas)" />
                    <ToggleButton x:Name="DetailsToggle" Grid.Column="3" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE8FD;" Click="OnDetailsToggleClick"
                                  AutomationProperties.Name="Lista con datos" ToolTipService.ToolTip="Lista con resolución, duración, fps, códec, fecha y cámara" />
                </Grid>

                <!-- Dónde se está; el botón sube a la carpeta de arriba y también recibe medios soltados. -->
                <Grid x:Name="FolderBar" Grid.Row="1" Padding="4,8,8,0" ColumnSpacing="2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UpButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE74A;" Click="OnUpClick" AllowDrop="True"
                            DragOver="OnUpDragOver" Drop="OnUpDrop" AutomationProperties.Name="Subir a la carpeta de arriba"
                            ToolTipService.ToolTip="Subir (suelta medios aquí para sacarlos de esta carpeta)" />
                    <TextBlock x:Name="FolderPathText" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                </Grid>

                <GridView x:Name="FolderGrid" Grid.Row="2" Padding="8,8,8,0" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnFolderClick" ContextRequested="OnFolderContextRequested" AllowDrop="True" DragOver="OnFolderDragOver" Drop="OnFolderDrop"
                          ItemsSource="{x:Bind Folders}" ItemTemplate="{StaticResource FolderTileTemplate}" Visibility="Collapsed" />

                <Grid x:Name="DetailsHeader" Grid.Row="3" Padding="20,8,20,2" ColumnSpacing="4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Resolución" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                    <TextBlock Grid.Column="1" Text="Duración" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                    <TextBlock Grid.Column="2" Text="Fps" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                    <TextBlock Grid.Column="3" Text="Códec" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                    <TextBlock Grid.Column="4" Text="Fecha" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                    <TextBlock Grid.Column="5" Text="Cámara" Style="{StaticResource CaptionTextStyle}" FontSize="{StaticResource MicroFontSize}" />
                </Grid>

                <GridView x:Name="MediaGrid" Grid.Row="4" Padding="8" SelectionMode="Extended" IsDoubleTapEnabled="True"
                          CanDragItems="True" DragItemsStarting="OnMediaDragStarting" DoubleTapped="OnMediaDoubleTapped"
                          ContextRequested="OnMediaContextRequested" ContainerContentChanging="OnMediaContainerChanging" Loaded="OnMediaGridLoaded"
                          ItemsSource="{x:Bind Media}" ItemTemplate="{StaticResource MediaTileTemplate}" />

                <ListView x:Name="MediaList" Grid.Row="4" Padding="0,0,0,8" SelectionMode="Extended" IsDoubleTapEnabled="True" Visibility="Collapsed"
                          CanDragItems="True" DragItemsStarting="OnMediaDragStarting" DoubleTapped="OnMediaDoubleTapped"
                          ContextRequested="OnMediaContextRequested"
                          ItemsSource="{x:Bind Media}" ItemTemplate="{StaticResource MediaRowTemplate}" />

                <!-- Medios nuevos de las carpetas vigiladas (LibraryView.Watched): importar con un clic o descartar. -->
                <Border x:Name="WatchedBanner" Grid.Row="4" VerticalAlignment="Bottom" Margin="8" Padding="12,8" Visibility="Collapsed" CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WatchedText" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
                        <Button Grid.Column="1" Content="Importar" Style="{StaticResource AccentButtonStyle}" Click="OnWatchedImportClick" />
                        <Button Grid.Column="2" Style="{StaticResource ToolButtonStyle}" Content="&#xE711;" Click="OnWatchedDismissClick"
                                AutomationProperties.Name="Descartar" ToolTipService.ToolTip="Descartar: no se vuelven a ofrecer" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="AudioPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="EmptyAudioText" Grid.Row="0" Style="{StaticResource PlaceholderTextStyle}" Margin="16,12"
                           Text="Importa música o efectos de sonido, o instala un paquete desde Complementos."
                           TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                    <StackPanel>
                        <GridView x:Name="AudioGrid" Padding="8" SelectionMode="Single" IsDoubleTapEnabled="True"
                                  CanDragItems="True" DragItemsStarting="OnMediaDragStarting" DoubleTapped="OnMediaDoubleTapped"
                                  ContextRequested="OnMediaContextRequested" ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ItemsSource="{x:Bind AudioMedia}" ItemTemplate="{StaticResource MediaTileTemplate}" />
                        <StackPanel x:Name="SoundsPanel" Padding="8,0,8,8" Spacing="4">
                            <TextBlock Text="Sonidos de paquetes" Style="{StaticResource CaptionTextStyle}" />
                            <GridView x:Name="SoundsGrid" SelectionMode="None" IsDoubleTapEnabled="True" CanDragItems="True"
                                      DragItemsStarting="OnElementDragStarting" DoubleTapped="OnElementDoubleTapped" ContextRequested="OnElementContextRequested"
                                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ItemsSource="{x:Bind Sounds}" ItemTemplate="{StaticResource SoundTileTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ElementsPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <GridView x:Name="ElementsGrid" Grid.Row="0" Padding="8" SelectionMode="Single" IsDoubleTapEnabled="True"
                          CanDragItems="True" DragItemsStarting="OnElementDragStarting" DoubleTapped="OnElementDoubleTapped"
                          ContextRequested="OnElementContextRequested"
                          ItemsSource="{x:Bind Elements}" ItemTemplate="{StaticResource ElementTileTemplate}" />
                <HyperlinkButton x:Name="MoreButton" Grid.Row="2" Margin="8,0,8,8" Click="OnPluginsClick"
                                 ToolTipService.ToolTip="Instala paquetes de transiciones, filtros y efectos desde Complementos">
                    <TextBlock x:Name="MoreText" Text="Conseguir más en Complementos" Style="{StaticResource CaptionTextStyle}" />
                </HyperlinkButton>
                <StackPanel x:Name="OwnPanel" Grid.Row="1" Padding="8,0,8,8" Spacing="4" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="OwnTitle" Text="Mis transiciones" Style="{StaticResource PanelTitleTextStyle}" Margin="0,8,0,0" />
                    <GridView SelectionMode="None" CanDragItems="True" DragItemsStarting="OnElementDragStarting"
                              IsDoubleTapEnabled="True" DoubleTapped="OnElementDoubleTapped" ContextRequested="OnElementContextRequested"
                              ItemsSource="{x:Bind OwnElements}" ItemTemplate="{StaticResource ElementTileTemplate}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="AiPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="8" Padding="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView SelectionMode="None" ItemsSource="{x:Bind Modules}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ModuleItem">
                            <StackPanel Padding="0,8" Spacing="2" ToolTipService.ToolTip="{x:Bind Description}">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="{x:Bind State}" Style="{StaticResource CaptionTextStyle}" Opacity="{x:Bind StateOpacity}" />
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" MaxLines="2" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                           Text="Cada módulo es un programa aparte con sus modelos: se instala desde Complementos y funciona sin internet." />
            </Grid>

            <markers:MarkersPanel x:Name="MarkersView" Grid.Row="1" Visibility="Collapsed" />

            <!-- Estado vacío: el logotipo atenuado y qué hacer; sigue a EmptyText, que maneja el código. -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="12" Margin="16" Visibility="{x:Bind EmptyText.Visibility, Mode=OneWay}">
                <shell:AppLogo Width="48" Height="48" Opacity="0.5" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource PlaceholderTextStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
