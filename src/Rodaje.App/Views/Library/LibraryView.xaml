<?xml version="1.0" encoding="utf-8"?>
<!-- Riel de íconos y biblioteca. Medios ya funciona (importar, doble clic para añadir a la pista principal); las demás categorías esperan su vista. -->
<UserControl
    x:Class="Rodaje.App.Views.Library.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rodaje.App.Views.Library">

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <StackPanel>
                <RadioButton x:Name="MediaTab" Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Medios" IsChecked="True" Checked="OnCategoryChecked" ToolTipService.ToolTip="Medios" Content="&#xE714;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Audio" Checked="OnCategoryChecked" ToolTipService.ToolTip="Audio" Content="&#xE8D6;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Texto" Checked="OnCategoryChecked" ToolTipService.ToolTip="Texto" Content="&#xE8D2;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Efectos" Checked="OnCategoryChecked" ToolTipService.ToolTip="Efectos" Content="&#xE790;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Transiciones" Checked="OnCategoryChecked" ToolTipService.ToolTip="Transiciones" Content="&#xE8AB;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="Filtros" Checked="OnCategoryChecked" ToolTipService.ToolTip="Filtros" Content="&#xE71C;" />
                <RadioButton Style="{StaticResource RailButtonStyle}" GroupName="LibraryRail" Tag="IA" Checked="OnCategoryChecked" ToolTipService.ToolTip="IA" Content="&#xE945;" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Style="{StaticResource PanelHeaderStyle}">
                <TextBlock x:Name="CategoryTitle" Text="Medios" Style="{StaticResource PanelTitleTextStyle}" />
                <Button x:Name="ImportButton" Content="Importar" HorizontalAlignment="Right" Click="OnImportClick" />
            </Grid>

            <GridView x:Name="MediaGrid" Grid.Row="1" Padding="8" SelectionMode="Single" IsDoubleTapEnabled="True"
                      DoubleTapped="OnMediaDoubleTapped" ItemsSource="{x:Bind Items}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:MediaItem">
                        <Grid Width="116" Height="86" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="2"
                              ToolTipService.ToolTip="{x:Bind Name}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,18" />
                            <StackPanel VerticalAlignment="Bottom" Padding="6,0,6,4">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" FontSize="11" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}" FontSize="10" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource PlaceholderTextStyle}" VerticalAlignment="Center" Margin="16"
                       Text="Importa videos o audios, o arrástralos a la ventana. Doble clic en uno lo añade al final de la pista principal." />
        </Grid>
    </Grid>
</UserControl>
