<?xml version="1.0" encoding="utf-8"?>
<!--
    Gestor de complementos: paquetes de contenido (.paquete, sin código) y módulos de IA (procesos aparte), cada uno en su
    repositorio de github.com/Dathinel y con los programas en los que funciona. Instalar desde archivo y desinstalar ya
    funcionan; la descarga desde las releases de GitHub llega en la fase 7.
-->
<UserControl
    x:Class="Rodaje.App.Views.Plugins.PluginsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rodaje.App.Views.Plugins">

    <UserControl.Resources>
        <DataTemplate x:Key="PluginTemplate" x:DataType="local:PluginRow">
            <Grid Padding="12,10" ColumnSpacing="12" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource StrokeBrush}"
                  BorderThickness="1" CornerRadius="2" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{StaticResource TextMutedBrush}" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource PanelTitleTextStyle}" />
                        <TextBlock Text="{x:Bind State}" Style="{StaticResource CaptionTextStyle}" Opacity="{x:Bind StateOpacity}" />
                        <TextBlock Text="{x:Bind Contents}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Text="{x:Bind WorksIn}" Style="{StaticResource CaptionTextStyle}" />
                    <HyperlinkButton Content="{x:Bind RepositoryText}" Visibility="{x:Bind RepositoryVisibility}" Click="OnRepositoryClick"
                                     Padding="0" FontSize="11" Foreground="{StaticResource AccentBrush}" ToolTipService.ToolTip="Abrir el repositorio en el navegador" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Instalar" Visibility="{x:Bind InstallVisibility}" IsEnabled="{x:Bind CanDownload}" Click="OnInstallClick"
                            ToolTipService.ToolTip="{x:Bind InstallTooltip}" />
                    <Button Content="Desinstalar" Visibility="{x:Bind UninstallVisibility}" Click="OnUninstallClick" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}" Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                       Text="Paquetes de contenido (transiciones, títulos, filtros, sonidos) y módulos de IA. Cada uno vive en su propio repositorio y algunos sirven también en los demás programas." />
            <Button Grid.Column="1" Content="Abrir carpeta" Click="OnOpenFolderClick" ToolTipService.ToolTip="Carpeta donde se instalan los complementos" />
            <Button Grid.Column="2" Content="Actualizar" Click="OnRefreshClick" />
            <Button x:Name="InstallFileButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Content="Instalar desde archivo…" Click="OnInstallFileClick" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource AccentSubtleBrush}" CornerRadius="2" Padding="10,6">
            <TextBlock x:Name="DownloadNote" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
        </Border>

        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="6" Padding="0,0,12,0">
                <TextBlock Text="Contenido" Style="{StaticResource HeaderTextStyle}" Margin="0,4,0,2" />
                <ItemsControl ItemsSource="{x:Bind ContentPackages}" ItemTemplate="{StaticResource PluginTemplate}" />
                <TextBlock Text="Módulos de IA" Style="{StaticResource HeaderTextStyle}" Margin="0,8,0,2" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,4"
                           Text="Cada módulo es un programa aparte con sus modelos, que corre en tu equipo. Lo que propone se revisa antes de aplicarse y se deshace con Ctrl+Z." />
                <ItemsControl ItemsSource="{x:Bind Modules}" ItemTemplate="{StaticResource PluginTemplate}" />
                <StackPanel x:Name="ProblemsPanel" Spacing="4" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock Text="No se pudieron cargar" Style="{StaticResource HeaderTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Problems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ProblemRow">
                                <StackPanel Padding="0,4">
                                    <TextBlock Text="{x:Bind Folder}" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{x:Bind Message}" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
