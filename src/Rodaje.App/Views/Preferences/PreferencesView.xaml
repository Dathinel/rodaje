<UserControl
    x:Class="Rodaje.App.Views.Preferences.PreferencesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabView x:Name="Tabs" IsAddTabButtonVisible="False" MaxHeight="600" MinWidth="520">
        <TabViewItem Header="General" IsClosable="False">
            <ScrollViewer><StackPanel Spacing="16" Padding="12">
                <TextBlock Text="Traer también el audio de los medios que caigan en estas pistas de video" FontWeight="SemiBold" />
                <StackPanel x:Name="LinkedAudioTracksPanel" Spacing="4" />
                <TextBlock Text="Duración por defecto de imágenes fijas" FontWeight="SemiBold" />
                <NumberBox x:Name="StillImageDurationBox" Header="Segundos" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" />
                <TextBlock Text="Carpeta de medios generados" FontWeight="SemiBold" />
                <TextBox x:Name="GeneratedFolderBox" PlaceholderText="Junto al proyecto" />
                <TextBlock Text="Carpeta de capturas de fotogramas" FontWeight="SemiBold" />
                <TextBox x:Name="StillCaptureFolderBox" PlaceholderText="Carpeta «Capturas» junto al proyecto" />
            </StackPanel></ScrollViewer>
        </TabViewItem>
        <TabViewItem Header="Rendimiento" IsClosable="False"><StackPanel Spacing="16" Padding="12">
            <ComboBox x:Name="ProxyUsageBox" Header="Proxies en la vista previa" />
            <CheckBox x:Name="AutoProxiesBox" Content="Generar proxies al importar videos pesados" />
            <ComboBox x:Name="PreviewQualityBox" Header="Calidad de la vista previa" />
            <ComboBox x:Name="TenBitViewerBox" Header="Visor de 10 bits" />
            <ComboBox x:Name="HdrViewerBox" Header="Visor HDR en scRGB" />
        </StackPanel></TabViewItem>
        <TabViewItem Header="Teclado" IsClosable="False"><StackPanel Padding="12"><ComboBox x:Name="ShortcutPresetBox" Header="Estilo de teclado" /></StackPanel></TabViewItem>
        <TabViewItem Header="Personalización" IsClosable="False">
            <ScrollViewer><StackPanel Spacing="12" Padding="12">
                <TextBlock Text="Apariencia" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeBox" Header="Tema" MinWidth="240" SelectionChanged="OnThemeChanged" />
                <TextBlock Text="Color de acento" Style="{StaticResource LabelTextStyle}" />
                <StackPanel x:Name="AccentPanel" Orientation="Horizontal" Spacing="6" />
                <TextBlock x:Name="AccentNote" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ScaleBox" Header="Escala de la interfaz (al guardar)" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="TimelineFontBox" Grid.Column="1" Header="Texto de la línea de tiempo" HorizontalAlignment="Stretch" />
                </Grid>
                <TextBlock Text="Espacio de trabajo" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="WorkspaceBox" Header="Distribución de los paneles" MinWidth="240" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="WorkspaceNameBox" PlaceholderText="Nombre para guardar la actual" MinWidth="220" MaxLength="40" />
                    <Button x:Name="SaveWorkspaceButton" Content="Guardar la actual" Click="OnSaveWorkspaceClick" VerticalAlignment="Bottom" />
                    <Button Content="Restablecer" Click="OnResetWorkspaceClick" VerticalAlignment="Bottom" ToolTipService.ToolTip="Vuelve a la distribución «Edición»" />
                </StackPanel>
                <TextBlock Text="Proyecto nuevo" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <NumberBox x:Name="VideoTracksBox" Header="Pistas de video" Minimum="1" Maximum="8" SpinButtonPlacementMode="Inline" />
                    <NumberBox x:Name="AudioTracksBox" Grid.Column="1" Header="Pistas de audio" Minimum="1" Maximum="8" SpinButtonPlacementMode="Inline" />
                </Grid>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="AspectBox" Header="Proporción" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="ResolutionBox" Grid.Column="1" Header="Resolución" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="FrameRateBox" Grid.Column="2" Header="Cuadros por segundo" HorizontalAlignment="Stretch" />
                </Grid>
                <TextBox x:Name="ProjectFolderBox" Header="Carpeta de proyectos" PlaceholderText="La última usada" />
                <TextBlock Text="Perfil" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="Apariencia, tema propio, espacios, proyecto nuevo, atajos y ratón en un archivo .rodaje-perfil." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Exportar perfil…" Click="OnExportProfileClick" />
                    <Button Content="Importar perfil…" Click="OnImportProfileClick" />
                    <Button Content="Restablecer todo…">
                        <Button.Flyout><Flyout><StackPanel Spacing="8" MaxWidth="280">
                            <TextBlock Text="Vuelven a fábrica el tema, el acento, la escala, los espacios propios, el proyecto nuevo y los cambios de teclas y ratón. Los temas propios guardados no se borran." TextWrapping="Wrap" />
                            <Button Content="Restablecer todo" Click="OnResetAllClick" />
                        </StackPanel></Flyout></Button.Flyout>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="ProfileNote" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel></ScrollViewer>
        </TabViewItem>
        <TabViewItem Header="Temas" IsClosable="False">
            <ScrollViewer><StackPanel Spacing="12" Padding="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="EditThemeBox" Header="Tema" MinWidth="180" SelectionChanged="OnEditThemeChanged" />
                    <Button Content="Duplicar" Click="OnDuplicateThemeClick" VerticalAlignment="Bottom" />
                    <Button x:Name="RenameThemeButton" Content="Renombrar" VerticalAlignment="Bottom">
                        <Button.Flyout><Flyout><StackPanel Spacing="8">
                            <TextBox x:Name="RenameBox" Header="Nombre nuevo" MinWidth="220" MaxLength="40" />
                            <Button Content="Renombrar" Click="OnRenameThemeClick" />
                        </StackPanel></Flyout></Button.Flyout>
                    </Button>
                    <Button x:Name="DeleteThemeButton" Content="Eliminar" VerticalAlignment="Bottom">
                        <Button.Flyout><Flyout><StackPanel Spacing="8">
                            <TextBlock x:Name="DeleteThemeText" TextWrapping="Wrap" MaxWidth="260" />
                            <Button Content="Eliminar" Click="OnDeleteThemeClick" />
                        </StackPanel></Flyout></Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ResetThemeButton" Content="Restablecer" Click="OnResetThemeClick" ToolTipService.ToolTip="Vuelve a los colores de Grafito" />
                    <Button Content="Importar tema…" Click="OnImportThemeClick" />
                    <Button Content="Exportar tema…" Click="OnExportThemeClick" />
                </StackPanel>
                <TextBlock x:Name="ThemeHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                <StackPanel x:Name="ThemeColorsPanel" Spacing="6" />
                <TextBlock x:Name="ContrastNote" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
            </StackPanel></ScrollViewer>
        </TabViewItem>
    </TabView>
</UserControl>
