<UserControl
    x:Class="Rodaje.App.Views.Preferences.PreferencesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabView IsAddTabButtonVisible="False" MaxHeight="600" MinWidth="520">
        <TabViewItem Header="General" IsClosable="False">
            <ScrollViewer><StackPanel Spacing="16" Padding="12">
                <TextBlock Text="Pistas para proyectos nuevos" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <NumberBox x:Name="VideoTracksBox" Header="Pistas de video" Minimum="1" Maximum="8" SpinButtonPlacementMode="Inline" />
                    <NumberBox x:Name="AudioTracksBox" Grid.Column="1" Header="Pistas de audio" Minimum="1" Maximum="8" SpinButtonPlacementMode="Inline" />
                </Grid>
                <TextBlock Text="Separar el audio de estas pistas de video al importar" FontWeight="SemiBold" />
                <StackPanel x:Name="LinkedAudioTracksPanel" Spacing="4" />
                <TextBlock Text="Duración por defecto de imágenes fijas" FontWeight="SemiBold" />
                <NumberBox x:Name="StillImageDurationBox" Header="Segundos" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" />
                <TextBlock Text="Carpeta de medios generados" FontWeight="SemiBold" />
                <TextBox x:Name="GeneratedFolderBox" PlaceholderText="Junto al proyecto" />
                <TextBlock Text="Carpeta de capturas de fotogramas" FontWeight="SemiBold" />
                <TextBox x:Name="StillCaptureFolderBox" PlaceholderText="Carpeta «Capturas» junto al proyecto" />
            </StackPanel></ScrollViewer>
        </TabViewItem>
        <TabViewItem Header="Rendimiento" IsClosable="False"><StackPanel Spacing="16" Padding="12">
            <ComboBox x:Name="ProxyUsageBox" Header="Proxies en la vista previa" />
            <CheckBox x:Name="AutoProxiesBox" Content="Generar proxies al importar videos pesados" />
            <ComboBox x:Name="PreviewQualityBox" Header="Calidad de la vista previa" />
        </StackPanel></TabViewItem>
        <TabViewItem Header="Teclado" IsClosable="False"><StackPanel Padding="12"><ComboBox x:Name="ShortcutPresetBox" Header="Estilo de teclado" /></StackPanel></TabViewItem>
        <TabViewItem Header="Apariencia" IsClosable="False"><StackPanel Padding="12"><TextBlock Text="La apariencia sigue el tema de Windows." TextWrapping="Wrap" /></StackPanel></TabViewItem>
    </TabView>
</UserControl>
