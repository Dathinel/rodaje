<?xml version="1.0" encoding="utf-8"?>
<!--
    Exportar (Ctrl+E, Ctrl+M o EXPORTAR): preajustes en tarjetas arriba, una vista sencilla (archivo, rango, forma,
    estimación; el formato es el del proyecto), «Avanzado» plegado con todo lo que admite el FFmpeg LGPL y la pregunta de rendimiento de cada vez.
    El estado vive en ExportDialogModel (sin WinUI, con pruebas); aquí solo se dibuja.
-->
<UserControl
    x:Class="Rodaje.App.Views.Export.ExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}">
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="FieldComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="160" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Preajustes -->
        <StackPanel Padding="20,16,20,12" Spacing="8" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Preajuste" Style="{StaticResource PanelTitleTextStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="Guardar como preajuste…" Click="OnSavePresetClick" />
                    <Button Content="Importar…" Click="OnImportPresetClick" />
                    <Button x:Name="ExportPresetButton" Content="Guardar en archivo…" Click="OnExportPresetClick" />
                    <Button x:Name="RemovePresetButton" Content="Quitar" Click="OnRemovePresetClick" />
                </StackPanel>
            </Grid>
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PresetCards" Orientation="Horizontal" Spacing="8" Padding="0,0,0,8" />
            </ScrollViewer>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
            <Grid Padding="20,12,20,16" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Vista sencilla y Avanzado -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Archivo" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" LostFocus="OnPathLostFocus" KeyDown="OnPathKeyDown" />
                        <Button Grid.Column="1" Content="Cambiar…" Click="OnBrowseClick" />
                    </Grid>
                    <TextBlock x:Name="PathNote" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Rango" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="RangeBox" Grid.Column="1" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnRangeChanged" DropDownClosed="OnDropDownClosed" />
                        <TextBlock Grid.Row="1" Text="Formato" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top" />
                        <TextBlock x:Name="SummaryText" Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                    </Grid>

                    <!-- El preajuste es para otra forma (Reels 9:16 con un proyecto 16:9): se exporta con la del proyecto. -->
                    <StackPanel x:Name="PresetShapePanel" Visibility="Collapsed" Spacing="0">
                        <TextBlock x:Name="PresetShapeText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                        <HyperlinkButton Content="Cambiar el formato del proyecto" Padding="0,2" Click="OnChangeProjectFormatClick" />
                    </StackPanel>
                    <ToggleButton x:Name="AdvancedToggle" Margin="0,8,0,0" Padding="12,4" Click="OnAdvancedClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="AdvancedGlyph" Glyph="&#xE76C;" FontSize="{StaticResource IconSmallFontSize}" />
                            <TextBlock Text="Avanzado" />
                        </StackPanel>
                    </ToggleButton>

                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="Contenedor" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Formato del archivo" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="ContainerBox" Grid.Column="1" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnContainerChanged" DropDownClosed="OnDropDownClosed" />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                                <CheckBox x:Name="FastStartBox" Content="Reproducir mientras se descarga (faststart)" Click="OnFastStartClick" />
                                <CheckBox x:Name="ChaptersBox" Content="Capítulos desde los marcadores" Click="OnChaptersClick" />
                            </StackPanel>
                            <TextBlock x:Name="SubtitlesLabel" Grid.Row="2" Text="Subtítulos" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="SubtitlesBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnSubtitlesChanged" DropDownClosed="OnDropDownClosed"
                                      ToolTipService.ToolTip="Quemados se ven siempre; como pista aparte se activan o desactivan en el reproductor (MP4, MOV, MKV y WebM)." />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Video" Style="{StaticResource SectionTitleStyle}" />
                            <ToggleSwitch x:Name="VideoSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnVideoToggled" />
                        </Grid>
                        <StackPanel x:Name="ProjectFormatRow" Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ProjectFormatText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Cambiar el formato del proyecto" Padding="0,2" Click="OnChangeProjectFormatClick" />
                        </StackPanel>
                        <Grid x:Name="VideoGrid" ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Códec" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="VideoCodecBox" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnVideoCodecChanged" DropDownClosed="OnDropDownClosed" />
                            <TextBlock Grid.Row="1" Text="Codificador" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="EncoderBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnEncoderChanged" DropDownClosed="OnDropDownClosed" />
                            <TextBlock Grid.Row="2" Text="Control de tasa" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="RateBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnRateChanged" DropDownClosed="OnDropDownClosed" />
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="RateValueBox" Width="96" SpinButtonPlacementMode="Hidden" ValueChanged="OnRateValueChanged" />
                                <NumberBox x:Name="RateMaxBox" Width="96" SpinButtonPlacementMode="Hidden" ValueChanged="OnRateMaxChanged" />
                                <TextBlock x:Name="RateUnit" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="Resolución" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="SizeBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnSizeChanged" DropDownClosed="OnDropDownClosed" />
                            <TextBlock Grid.Row="4" Text="Forma" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="FitBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnFitChanged" DropDownClosed="OnDropDownClosed" />
                            <TextBlock Grid.Row="5" Text="Cuadros por segundo" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="FrameRateBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnFrameRateChanged" DropDownClosed="OnDropDownClosed" />
                            <TextBlock Grid.Row="6" Text="Bits por canal" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="BitDepthBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnBitDepthChanged" DropDownClosed="OnDropDownClosed" />
                            <TextBlock Grid.Row="7" Text="Muestreo de color" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="ChromaBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnChromaChanged" DropDownClosed="OnDropDownClosed"
                                      ToolTipService.ToolTip="4:2:0 es lo que reproducen todos los dispositivos; 4:2:2 y 4:4:4 conservan más color para seguir editando o para croma y texto fino (solo en los codificadores que lo admiten)." />
                            <TextBlock Grid.Row="8" Text="Perfil" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="ProfileBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnProfileChanged" DropDownClosed="OnDropDownClosed" />
                            <TextBlock Grid.Row="9" Text="Velocidad del codificador" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="SpeedPresetBox" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnSpeedPresetChanged" DropDownClosed="OnDropDownClosed" />
                            <TextBlock Grid.Row="10" Text="Fotograma clave cada" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="KeyframeBox" Width="96" SpinButtonPlacementMode="Hidden" Minimum="0.1" Maximum="60" ValueChanged="OnKeyframeChanged" />
                                <TextBlock Text="s" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Audio" Style="{StaticResource SectionTitleStyle}" />
                            <ToggleSwitch x:Name="AudioSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAudioToggled" />
                        </Grid>
                        <Grid x:Name="AudioGrid" ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Códec" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="AudioCodecBox" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnAudioCodecChanged" DropDownClosed="OnDropDownClosed" />
                            <TextBlock Grid.Row="1" Text="Tasa" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="AudioRateBox" Width="96" SpinButtonPlacementMode="Hidden" Minimum="32" Maximum="512" ValueChanged="OnAudioRateChanged" />
                                <TextBlock x:Name="AudioRateUnit" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="Frecuencia" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="SampleRateBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnSampleRateChanged" DropDownClosed="OnDropDownClosed" />
                            <TextBlock Grid.Row="3" Text="Canales" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="ChannelsBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnChannelsChanged" DropDownClosed="OnDropDownClosed" />
                            <TextBlock Grid.Row="4" Text="Normalizar sonoridad" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="LoudnessBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnLoudnessChanged" DropDownClosed="OnDropDownClosed" />
                        </Grid>

                        <!-- Lo que recibe ffmpeg.exe con estos ajustes, para leerlo o pegarlo en una consola. -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <HyperlinkButton x:Name="CommandButton" Content="Copiar la línea de ffmpeg" Padding="0,2" Click="OnCopyCommandClick"
                                             ToolTipService.ToolTip="Copia al portapapeles los argumentos con los que Rodaje lanza ffmpeg.exe: codificador, control de tasa, perfil, muestreo, audio y contenedor. La imagen entra cruda por una tubería (pipe:0) y la mezcla por un WAV temporal." />
                            <TextBlock Text="(lo que recibe ffmpeg.exe con estos ajustes)" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Rendimiento, estimación y avisos -->
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="¿Cómo exporto?" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <RadioButton x:Name="PerformanceFast" GroupName="Performance" Tag="Fastest" Checked="OnPerformanceChecked">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="PerformanceFastTitle" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="PerformanceFastDetail" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PerformanceLow" GroupName="Performance" Tag="Background" Checked="OnPerformanceChecked">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="PerformanceLowTitle" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="PerformanceLowDetail" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </RadioButton>

                    <Border Margin="0,8,0,0" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Estimación" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="EstimateText" Style="{StaticResource HeaderTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="EstimateDetail" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="AdjustmentsText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed" />
                    <TextBlock x:Name="ProblemsText" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource MeterHighBrush}" TextWrapping="Wrap"
                               TextTrimming="None" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="20,12" ColumnSpacing="8" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterNote" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
            <Button Grid.Column="1" Content="Cancelar" Click="OnCancelClick" />
            <Button x:Name="VersionsButton" Grid.Column="2" Content="Varias versiones…" Click="OnVersionsClick"
                    ToolTipService.ToolTip="Elegir varios preajustes y exportarlos todos de una vez (por ejemplo, web 16:9 y vertical 9:16)" />
            <Button x:Name="ExportButton" Grid.Column="3" Content="Exportar" Style="{StaticResource AccentButtonStyle}" MinWidth="110" Click="OnExportClick" />
        </Grid>
    </Grid>
</UserControl>
