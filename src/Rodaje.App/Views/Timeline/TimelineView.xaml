<?xml version="1.0" encoding="utf-8"?>
<!--
    Línea de tiempo: barra estilo Vegas, regla, cabeceras de pista y pistas. Esta versión del armazón solo muestra un
    resumen de la secuencia y el cursor; la vista completa la construye su propia tarea.
-->
<UserControl
    x:Class="Rodaje.App.Views.Timeline.TimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource BarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="8,0">
            <TextBlock Text="Línea de tiempo" Style="{StaticResource PanelTitleTextStyle}" />
            <TextBlock HorizontalAlignment="Right" Text="{x:Bind Session.PositionText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource TimecodeTextStyle}" />
        </Grid>

        <TextBlock x:Name="SummaryText" Grid.Row="1" Style="{StaticResource PlaceholderTextStyle}" VerticalAlignment="Center" Margin="16" />
    </Grid>
</UserControl>
