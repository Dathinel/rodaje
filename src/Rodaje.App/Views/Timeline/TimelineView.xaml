<?xml version="1.0" encoding="utf-8"?>
<!--
    Línea de tiempo (maqueta D-018): barra con herramientas, interruptores y acciones; regla, cabeceras de
    pista y pistas. Las pistas se dibujan desde código (TimelineRenderer), con elementos reciclados y solo lo visible.
-->
<UserControl
    x:Class="Rodaje.App.Views.Timeline.TimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    IsTabStop="True" UseSystemFocusVisuals="False">

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource BarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <ToggleButton x:Name="NormalToolButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE7C9;" Click="OnToolClick" />
                <ToggleButton x:Name="EnvelopeToolButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE9D9;" Click="OnToolClick" />
                <ToggleButton x:Name="SelectionToolButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE8B3;" Click="OnToolClick" />
                <ToggleButton x:Name="ZoomToolButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE71E;" Click="OnToolClick" />
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <ToggleButton x:Name="MagneticButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE840;" Click="OnToggleClick" />
                <ToggleButton x:Name="SnappingButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE71B;" Click="OnToggleClick" />
                <ToggleButton x:Name="AutoRippleButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE8AB;" Click="OnToggleClick" />
                <ComboBox x:Name="RippleModeBox" Width="196" Height="28" MinHeight="0" Padding="8,0,0,0" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"
                          SelectionChanged="OnRippleModeChanged">
                    <ComboBoxItem Content="Ripple: pistas afectadas" />
                    <ComboBoxItem Content="Ripple: todas las pistas" />
                    <ComboBoxItem Content="Ripple: pistas, marcadores y regiones" />
                </ComboBox>
                <ToggleButton x:Name="CrossfadeButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE895;" Click="OnToggleClick" />
                <ToggleButton x:Name="LockEnvelopesButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE72E;" Click="OnToggleClick" />
                <ToggleButton x:Name="IgnoreGroupsButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE762;" Click="OnToggleClick" />
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button x:Name="SplitButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE8C6;" Click="OnActionClick" />
                <Button x:Name="TrimStartButton" Style="{StaticResource ToolButtonStyle}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" Content="[" Click="OnActionClick" />
                <Button x:Name="TrimEndButton" Style="{StaticResource ToolButtonStyle}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" Content="]" Click="OnActionClick" />
                <Button x:Name="DeleteButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE74D;" Click="OnActionClick" />
                <Button x:Name="MarkerButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE7C1;" Click="OnActionClick" />
                <Button x:Name="RegionButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE8EC;" Click="OnActionClick" />
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button x:Name="UndoButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE7A7;" Click="OnActionClick" IsEnabled="{x:Bind Session.CanUndo, Mode=OneWay, FallbackValue=False}" />
                <Button x:Name="RedoButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE7A6;" Click="OnActionClick" IsEnabled="{x:Bind Session.CanRedo, Mode=OneWay, FallbackValue=False}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="ZoomOutButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE71F;" Click="OnActionClick" />
                <Slider x:Name="ZoomSlider" Width="120" Minimum="0" Maximum="1000" StepFrequency="1" VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False" ValueChanged="OnZoomSliderChanged" />
                <Button x:Name="ZoomInButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE8A3;" Click="OnActionClick" />
                <Button x:Name="ZoomFitButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE9A6;" Click="OnActionClick" />
                <Button x:Name="ZoomSelectionButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE740;" Click="OnActionClick" />
                <TextBlock Margin="12,0,4,0" Text="{x:Bind Session.PositionText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource TimecodeTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- Migas de pan dentro de un clip compuesto y estado del visor de origen; ocultas si no hay nada que decir. -->
        <Border x:Name="ContextBar" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource BarBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="8,2">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" />
                <StackPanel x:Name="SourcePanel" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource BarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,1">
                <TextBlock x:Name="SummaryText" Margin="12,0" Style="{StaticResource CaptionTextStyle}" />
            </Border>

            <Canvas x:Name="RulerCanvas" Grid.Column="1" Background="{StaticResource BarBrush}"
                    PointerPressed="OnRulerPointerPressed" PointerMoved="OnRulerPointerMoved" PointerReleased="OnRulerPointerReleased"
                    PointerCaptureLost="OnRulerPointerCaptureLost" PointerWheelChanged="OnWheel" />

            <Canvas x:Name="HeadersCanvas" Grid.Row="1" Background="{StaticResource BarBrush}" PointerWheelChanged="OnWheel" />

            <Grid x:Name="LanesHost" Grid.Row="1" Grid.Column="1" Background="{StaticResource BackgroundBrush}" AllowDrop="True"
                  PointerPressed="OnLanesPointerPressed" PointerMoved="OnLanesPointerMoved" PointerReleased="OnLanesPointerReleased"
                  PointerCaptureLost="OnLanesPointerCaptureLost" PointerExited="OnLanesPointerExited" PointerWheelChanged="OnWheel"
                  DragEnter="OnLanesDragEnter" DragOver="OnLanesDragOver" DragLeave="OnLanesDragLeave" Drop="OnLanesDrop">
                <Canvas x:Name="RowsCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="ClipsCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
            </Grid>

            <Canvas x:Name="PlayheadLayer" Grid.Column="1" Grid.RowSpan="2" IsHitTestVisible="False" />

            <primitives:ScrollBar x:Name="VerticalBar" Grid.Row="1" Grid.Column="2" Orientation="Vertical" IndicatorMode="MouseIndicator"
                                  Minimum="0" SmallChange="20" ValueChanged="OnVerticalBarChanged" />
            <primitives:ScrollBar x:Name="HorizontalBar" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" IndicatorMode="MouseIndicator"
                                  Minimum="0" SmallChange="40" ValueChanged="OnHorizontalBarChanged" />
        </Grid>
    </Grid>
</UserControl>
