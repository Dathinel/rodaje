<?xml version="1.0" encoding="utf-8"?>
<!--
    Teclado español dibujado con la paleta: cada tecla dice qué lanza, con el color de su grupo. Ctrl, Mayús y Alt del
    dibujo cambian la capa (qué hace Ctrl+tecla); clic en una tecla filtra la lista. Tab entra y sale del teclado de una
    vez; dentro, las flechas van de tecla en tecla.
-->
<UserControl
    x:Class="Rodaje.App.Views.Shortcuts.KeyboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="KeyCapButtonStyle" TargetType="Button" BasedOn="{StaticResource RodajeButtonStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="3,2,2,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualMargin" Value="-2" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LayerText" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
            <StackPanel x:Name="Legend" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" />
        </Grid>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
            <Canvas x:Name="Board" XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once"
                    AutomationProperties.Name="Teclado: cada tecla dice qué acción lanza" />
        </Viewbox>
        <TextBlock x:Name="InfoText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" TextTrimming="None" MinHeight="18"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
