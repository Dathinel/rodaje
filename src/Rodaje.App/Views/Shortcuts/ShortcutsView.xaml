<?xml version="1.0" encoding="utf-8"?>
<!--
    Página de atajos (D-018). Vista esencial: el teclado y el ratón con los atajos básicos y su lista. Vista avanzada:
    estilo, búsqueda por acción o por tecla, teclado y ratón dibujados (clic en una tecla o un botón para cambiarlo),
    hoja rápida, exportar e importar y los grupos en dos columnas. Si una combinación era de otra acción, se pregunta si
    intercambiarlas o quitársela, y el aviso permite deshacerlo.
-->
<UserControl
    x:Class="Rodaje.App.Views.Shortcuts.ShortcutsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rodaje.App.Views.Shortcuts">

    <UserControl.Resources>
        <Style x:Key="PresetTabStyle" TargetType="RadioButton" BasedOn="{StaticResource PanelTabStyle}">
            <Setter Property="Height" Value="32" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,8,16,10" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4">
                <StackPanel x:Name="ModeTabs" Orientation="Horizontal" AutomationProperties.Name="Vista de la página"
                            XYFocusKeyboardNavigation="Enabled">
                    <RadioButton x:Name="EssentialTab" Style="{StaticResource PresetTabStyle}" GroupName="ShortcutsMode" Content="Esencial"
                                 Checked="OnModeChecked" ToolTipService.ToolTip="El teclado con los atajos básicos" />
                    <RadioButton x:Name="AdvancedTab" Style="{StaticResource PresetTabStyle}" GroupName="ShortcutsMode" Content="Avanzado"
                                 Checked="OnModeChecked" ToolTipService.ToolTip="Todas las acciones: buscar y cambiar teclas" />
                </StackPanel>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" Margin="12,0" />
                <TextBlock Text="Estilo de teclado" Style="{StaticResource LabelTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <StackPanel x:Name="PresetTabs" Orientation="Horizontal" AutomationProperties.Name="Estilo de teclado"
                            XYFocusKeyboardNavigation="Enabled">
                    <RadioButton x:Name="RodajeTab" Style="{StaticResource PresetTabStyle}" GroupName="ShortcutPreset" Content="Rodaje"
                                 Checked="OnPresetChecked" ToolTipService.ToolTip="Las teclas de Rodaje" />
                    <RadioButton x:Name="AgileTab" Style="{StaticResource PresetTabStyle}" GroupName="ShortcutPreset" Content="Ágil"
                                 Checked="OnPresetChecked" ToolTipService.ToolTip="Pocas teclas y Ctrl+B para cortar, como en los editores rápidos" />
                    <RadioButton x:Name="ClassicTab" Style="{StaticResource PresetTabStyle}" GroupName="ShortcutPreset" Content="Clásico"
                                 Checked="OnPresetChecked" ToolTipService.ToolTip="Teclas de editor de escritorio tradicional: flechas para el zoom y Alt para recortar" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="AdvancedTools" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,8,0,0" VerticalAlignment="Center">
                <ToggleButton x:Name="KeyboardToggle" Checked="OnKeyboardToggleChanged" Unchecked="OnKeyboardToggleChanged" MinHeight="26" Padding="10,0" FontSize="{StaticResource BodyFontSize}"
                              AutomationProperties.Name="Ver teclado y ratón"
                              ToolTipService.ToolTip="Mostrar el teclado y el ratón con lo que hace cada tecla y botón; clic en uno para cambiarlo">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE765;" VerticalAlignment="Center" />
                        <TextBlock Text="Teclado y ratón" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="CheatSheetToggle" Checked="OnCheatSheetToggleChanged" Unchecked="OnCheatSheetToggleChanged" MinHeight="26" Padding="10,0" FontSize="{StaticResource BodyFontSize}"
                              AutomationProperties.Name="Hoja rápida"
                              ToolTipService.ToolTip="Los 15 atajos más útiles, para imprimir o guardar">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE8A5;" VerticalAlignment="Center" />
                        <TextBlock Text="Hoja rápida" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button Content="Exportar…" Click="OnExportClick"
                        ToolTipService.ToolTip="Guardar tus teclas y tu ratón de todos los estilos en un archivo JSON" />
                <Button Content="Importar…" Click="OnImportClick"
                        ToolTipService.ToolTip="Usar las teclas y el ratón de un archivo exportado (se puede deshacer)" />
                <Button Content="Restablecer todo" Click="OnResetAllClick"
                        ToolTipService.ToolTip="Volver a las teclas de fábrica de este estilo (se puede deshacer)" />
            </StackPanel>

            <Grid x:Name="SearchRow" Grid.Row="1" ColumnSpacing="10" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="380" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" MinWidth="160" PlaceholderText="Busca una acción («cortar») o una tecla («Ctrl+S»)"
                         TextChanged="OnSearchChanged" AutomationProperties.Name="Buscar atajos por acción o por tecla" />
                <Button x:Name="KeyFilterChip" Grid.Column="1" Visibility="Collapsed" Click="OnKeyFilterClick" BorderBrush="{StaticResource AccentBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="KeyFilterText" VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="9" Text="&#xE711;" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="CountText" Grid.Column="2" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Padding="16,12,16,20">
                <StackPanel x:Name="EssentialPanel" Spacing="14">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                               Text="Los atajos que más vas a usar. Para ver todas las acciones y cambiar teclas, pasa a «Avanzado»." />
                    <Border Padding="12" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="2">
                        <Grid x:Name="EssentialDrawings" ColumnSpacing="16" RowSpacing="12" SizeChanged="OnDrawingsSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <local:KeyboardView x:Name="EssentialKeyboard" />
                            <local:MouseView x:Name="EssentialMouse" Grid.Column="1" />
                        </Grid>
                    </Border>
                    <Grid x:Name="EssentialList" ColumnSpacing="28" SizeChanged="OnEssentialListSizeChanged" />
                </StackPanel>

                <StackPanel x:Name="AdvancedPanel" Spacing="14" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                               Text="Pulsa «Cambiar» (o una tecla de la fila) y después la combinación nueva, o abre «Teclado y ratón» y haz clic en una tecla o un botón. Si ya era de otra acción, eliges entre intercambiarlas o quitársela, y puedes deshacerlo. La barra naranja marca lo que cambiaste; cada estilo guarda sus propios cambios." />

                    <Border x:Name="KeyboardPanel" Visibility="Collapsed" Padding="12" Background="{StaticResource BarBrush}"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="2">
                        <StackPanel Spacing="12">
                            <Grid x:Name="Drawings" ColumnSpacing="16" RowSpacing="12" SizeChanged="OnDrawingsSizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <local:KeyboardView x:Name="Keyboard" />
                                <local:MouseView x:Name="MouseDrawing" Grid.Column="1" />
                            </Grid>
                            <local:BindingEditor x:Name="Editor" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="CheatSheetPanel" Visibility="Collapsed" Padding="12" Background="{StaticResource BarBrush}"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="2">
                        <local:CheatSheetView x:Name="Sheet" />
                    </Border>

                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource PlaceholderTextStyle}" Margin="0,24" />

                    <Grid x:Name="GroupsGrid" ColumnSpacing="32" SizeChanged="OnGroupsSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="LeftColumn" Spacing="18" />
                        <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="18" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
