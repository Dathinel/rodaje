<?xml version="1.0" encoding="utf-8"?>
<!--
    Página de atajos (D-018): estilo de teclado (Rodaje, Como CapCut, Como Vegas), búsqueda por acción o por tecla,
    teclado dibujado, hoja rápida y los grupos en dos columnas. Cada fila cambia sus teclas con un clic; si la tecla era
    de otra acción, se intercambian y el aviso de arriba permite deshacerlo.
-->
<UserControl
    x:Class="Rodaje.App.Views.Shortcuts.ShortcutsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rodaje.App.Views.Shortcuts">

    <UserControl.Resources>
        <Style x:Key="PresetTabStyle" TargetType="RadioButton" BasedOn="{StaticResource PanelTabStyle}">
            <Setter Property="Height" Value="32" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,8,16,10" RowSpacing="8" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Estilo de teclado" Style="{StaticResource LabelTextStyle}" Margin="0,0,8,0" />
                <StackPanel x:Name="PresetTabs" Orientation="Horizontal" AutomationProperties.Name="Estilo de teclado"
                            XYFocusKeyboardNavigation="Enabled">
                    <RadioButton x:Name="RodajeTab" Style="{StaticResource PresetTabStyle}" GroupName="ShortcutPreset" Content="Rodaje"
                                 Checked="OnPresetChecked" ToolTipService.ToolTip="Las teclas de Rodaje" />
                    <RadioButton x:Name="CapCutTab" Style="{StaticResource PresetTabStyle}" GroupName="ShortcutPreset" Content="Como CapCut"
                                 Checked="OnPresetChecked" ToolTipService.ToolTip="Teclas parecidas a las de CapCut, si vienes de ahí" />
                    <RadioButton x:Name="VegasTab" Style="{StaticResource PresetTabStyle}" GroupName="ShortcutPreset" Content="Como Vegas"
                                 Checked="OnPresetChecked" ToolTipService.ToolTip="Teclas parecidas a las de Vegas Pro, si vienes de ahí" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="KeyboardToggle" Checked="OnKeyboardToggleChanged" Unchecked="OnKeyboardToggleChanged" MinHeight="26" Padding="10,0" FontSize="{StaticResource BodyFontSize}"
                              AutomationProperties.Name="Ver teclado"
                              ToolTipService.ToolTip="Mostrar un teclado con lo que hace cada tecla">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE765;" VerticalAlignment="Center" />
                        <TextBlock Text="Ver teclado" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="CheatSheetToggle" Checked="OnCheatSheetToggleChanged" Unchecked="OnCheatSheetToggleChanged" MinHeight="26" Padding="10,0" FontSize="{StaticResource BodyFontSize}"
                              AutomationProperties.Name="Hoja rápida"
                              ToolTipService.ToolTip="Los 15 atajos más útiles, para imprimir o guardar">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE8A5;" VerticalAlignment="Center" />
                        <TextBlock Text="Hoja rápida" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button Content="Restablecer todo" Click="OnResetAllClick"
                        ToolTipService.ToolTip="Volver a las teclas de fábrica de este estilo (se puede deshacer)" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="SearchBox" Width="380" PlaceholderText="Busca una acción («cortar») o una tecla («Ctrl+S»)"
                         TextChanged="OnSearchChanged" AutomationProperties.Name="Buscar atajos por acción o por tecla" />
                <Button x:Name="KeyFilterChip" Visibility="Collapsed" Click="OnKeyFilterClick" BorderBrush="{StaticResource AccentBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="KeyFilterText" VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="9" Text="&#xE711;" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="CountText" Style="{StaticResource CaptionTextStyle}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational" CornerRadius="0" Margin="0">
            <InfoBar.ActionButton>
                <Button x:Name="NoticeAction" Click="OnNoticeActionClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ScrollViewer x:Name="Scroller" Grid.Row="2" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,12,16,20" Spacing="14">
                <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                           Text="Pulsa «Cambiar» (o una tecla de la fila) y después la combinación nueva. Si ya era de otra acción, se intercambian y puedes deshacerlo arriba. La barra naranja marca lo que cambiaste; cada estilo guarda sus propios cambios." />

                <Border x:Name="KeyboardPanel" Visibility="Collapsed" Padding="12" Background="{StaticResource BarBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="2">
                    <local:KeyboardView x:Name="Keyboard" />
                </Border>

                <Border x:Name="CheatSheetPanel" Visibility="Collapsed" Padding="12" Background="{StaticResource BarBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="2">
                    <local:CheatSheetView x:Name="Sheet" />
                </Border>

                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource PlaceholderTextStyle}" Margin="0,24" />

                <Grid x:Name="GroupsGrid" ColumnSpacing="32" SizeChanged="OnGroupsSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LeftColumn" Spacing="18" />
                    <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="18" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
