<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Rodaje.App.Views.Player.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:meters="using:Rodaje.App.Views.Meters"
    xmlns:player="using:Rodaje.App.Views.Player">

    <Grid x:Name="RootGrid" Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="TransportRow" Height="44" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Style="{StaticResource PanelHeaderStyle}" Padding="12,0,8,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Reproductor" Style="{StaticResource PanelTitleTextStyle}" />
                <DropDownButton x:Name="FormatButton" MinHeight="26" Padding="8,0" Margin="4,0,0,0" FontSize="{StaticResource BodyFontSize}"
                                AutomationProperties.Name="Formato del proyecto">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="FormatMenu" Placement="BottomEdgeAlignedLeft" Opening="OnFormatMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Border x:Name="ShuttleBadge" Visibility="Collapsed" Background="{StaticResource AccentSubtleBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,1">
                    <TextBlock x:Name="ShuttleText" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextBrush}" />
                </Border>
                <Border x:Name="ProxyBadge" Visibility="Collapsed" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,1"
                        ToolTipService.ToolTip="La vista previa usa un proxy: una copia liviana del medio. La exportación usa siempre los originales.">
                    <TextBlock Text="Proxy" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextBrush}" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" VerticalAlignment="Center">
                <DropDownButton x:Name="QualityButton" Content="Auto" MinHeight="26" Padding="8,0" FontSize="{StaticResource BodyFontSize}"
                                ToolTipService.ToolTip="Calidad de la vista previa. Auto baja la resolución al reproducir si la GPU no llega y vuelve a completa en pausa; la exportación usa siempre la completa.">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="QualityAutoItem" Text="Automática" GroupName="PlayerQuality" Tag="Auto" Click="OnQualityClick" />
                            <RadioMenuFlyoutItem x:Name="QualityFullItem" Text="Completa" GroupName="PlayerQuality" Tag="Full" Click="OnQualityClick" />
                            <RadioMenuFlyoutItem x:Name="QualityHalfItem" Text="Mitad" GroupName="PlayerQuality" Tag="Half" Click="OnQualityClick" />
                            <RadioMenuFlyoutItem x:Name="QualityQuarterItem" Text="Cuarto" GroupName="PlayerQuality" Tag="Quarter" Click="OnQualityClick" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="ZoomButton" Content="Ajustar" MinHeight="26" Padding="8,0" FontSize="{StaticResource BodyFontSize}"
                                ToolTipService.ToolTip="Zoom de la vista previa">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="ZoomFitItem" Text="Ajustar" GroupName="PlayerZoom" IsChecked="True" Click="OnZoomClick" />
                            <RadioMenuFlyoutItem x:Name="ZoomHalfItem" Text="50 %" GroupName="PlayerZoom" Click="OnZoomClick" />
                            <RadioMenuFlyoutItem x:Name="ZoomFullItem" Text="100 %" GroupName="PlayerZoom" Click="OnZoomClick" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="SafeAreasButton" MinHeight="26" Padding="8,0" Background="Transparent" BorderThickness="0"
                                FontFamily="{StaticResource IconFontFamily}" FontSize="{StaticResource IconFontSize}" Content="&#xE7A8;"
                                AutomationProperties.Name="Zonas seguras">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SafeZonesMenu" Placement="BottomEdgeAlignedRight" Opening="OnSafeZonesMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <ToggleButton x:Name="CompareButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE89F;"
                              FontFamily="{StaticResource IconFontFamily}" Click="OnCompareClick" AutomationProperties.Name="Antes y después"
                              ToolTipService.ToolTip="Antes y después: divide la imagen con una cortina; a la izquierda se ve sin color, LUT, ruedas ni curvas (solo vista previa)" />
                <ToggleButton x:Name="ScopesButton" Style="{StaticResource ToolToggleButtonStyle}" Content="&#xE9D2;"
                              FontFamily="{StaticResource IconFontFamily}" Click="OnScopesClick" AutomationProperties.Name="Monitores de imagen"
                              ToolTipService.ToolTip="Monitores de imagen: forma de onda, desfile RGB, vectorscopio e histograma" />
                <Button x:Name="FullScreenButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE740;" Click="OnFullScreenClick" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ViewerArea" Grid.Row="1" Background="{StaticResource ViewerSurroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--
                El escenario: la imagen del render y todo lo que se dibuja encima comparten el mismo margen y el mismo
                rectángulo (ViewerGeometry), en píxeles físicos enteros. El render pinta la imagen sobre el gris del visor;
                el contorno marca su forma real y el aviso del visor vacío va dentro de ella.
            -->
            <Grid x:Name="Stage" Margin="8">
                <SwapChainPanel x:Name="VideoPanel" x:FieldModifier="internal" DoubleTapped="OnVideoDoubleTapped"
                                PointerPressed="OnVideoPointerPressed" PointerMoved="OnVideoPointerMoved"
                                PointerReleased="OnVideoPointerReleased" PointerCaptureLost="OnVideoPointerCaptureLost" />
                <Canvas x:Name="FrameCanvas" IsHitTestVisible="False">
                    <Rectangle x:Name="CanvasOutline" Stroke="{StaticResource StrokeBrush}" StrokeThickness="1" />
                    <Border x:Name="StatusHost" Padding="16,12">
                        <TextBlock x:Name="StatusText" x:FieldModifier="internal" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Canvas>
                <!-- Zonas seguras (rodaje.safezones): las dibuja PlayerView.SafeZones con el rectángulo de la imagen. -->
                <Canvas x:Name="SafeAreaCanvas" IsHitTestVisible="False" Visibility="Collapsed" />
                <Canvas x:Name="SafeZoneEditCanvas" Visibility="Collapsed" Background="Transparent"
                        PointerPressed="OnSafeZoneEditPressed" PointerMoved="OnSafeZoneEditMoved"
                        PointerReleased="OnSafeZoneEditReleased" PointerCaptureLost="OnSafeZoneEditCaptureLost" />
                <Canvas x:Name="TitleCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                    <Polygon x:Name="TitleOutline" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" />
                    <Rectangle x:Name="TitleGripTopLeft" Width="8" Height="8" Fill="{StaticResource TextBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" />
                    <Rectangle x:Name="TitleGripTopRight" Width="8" Height="8" Fill="{StaticResource TextBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" />
                    <Rectangle x:Name="TitleGripBottomRight" Width="8" Height="8" Fill="{StaticResource TextBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" />
                    <Rectangle x:Name="TitleGripBottomLeft" Width="8" Height="8" Fill="{StaticResource TextBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" />
                    <Line x:Name="TitleRotateStem" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" />
                    <Ellipse x:Name="TitleGripRotate" Width="10" Height="10" Fill="{StaticResource TextBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" />
                </Canvas>
                <Canvas x:Name="TransformCanvas" IsHitTestVisible="False" Visibility="Collapsed" />
                <!-- Máscaras (PlayerView.Masks): contornos, cajas, vértices y lo que se dibuja; la ayuda de la herramienta arriba. -->
                <Canvas x:Name="MaskCanvas" IsHitTestVisible="False" Visibility="Collapsed" />
                <!-- Seguimiento (PlayerView.Tracking): puntos con su patrón y su zona de búsqueda. -->
                <Canvas x:Name="TrackCanvas" IsHitTestVisible="False" Visibility="Collapsed" />
                <Border x:Name="MaskHint" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8" Padding="8,4" CornerRadius="4" Background="{StaticResource ScrimBrush}" MaxWidth="560">
                    <TextBlock x:Name="MaskHintText" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" TextTrimming="None" />
                </Border>
                <!-- Recorte que se ajusta (PlayerView.Image): la imagen entera, lo que se quita en sombra y ocho asas. -->
                <Canvas x:Name="CropCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                    <Path x:Name="CropShade" Fill="{StaticResource ShadeBrush}" />
                    <Polygon x:Name="CropOutline" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                </Canvas>
                <!-- Antes/después: a la izquierda de la cortina, sin color; se arrastra de la línea o del asa. -->
                <Canvas x:Name="CompareCanvas" Visibility="Collapsed">
                    <Rectangle x:Name="CompareHit" Width="16" Fill="Transparent" PointerPressed="OnComparePressed" PointerMoved="OnCompareMoved"
                               PointerReleased="OnCompareReleased" PointerCaptureLost="OnCompareReleased" />
                    <Rectangle x:Name="CompareLine" Width="2" Fill="{StaticResource TextBrush}" IsHitTestVisible="False" />
                    <Border x:Name="CompareGrip" Width="28" Height="28" CornerRadius="14" Background="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" PointerPressed="OnComparePressed"
                            PointerMoved="OnCompareMoved" PointerReleased="OnCompareReleased" PointerCaptureLost="OnCompareReleased"
                            ToolTipService.ToolTip="Arrastra: a la izquierda, sin color; a la derecha, con color">
                        <FontIcon Glyph="&#xE8AB;" FontSize="{StaticResource IconFontSize}" Foreground="{StaticResource BackgroundBrush}" />
                    </Border>
                    <TextBlock x:Name="CompareBefore" Text="Antes" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextBrush}" IsHitTestVisible="False" />
                    <TextBlock x:Name="CompareAfter" Text="Después" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextBrush}" IsHitTestVisible="False" />
                </Canvas>
                <!-- Roll y slide: los dos cuadros del corte mientras se arrastra (PlayerView.TrimPreview). -->
                <Grid x:Name="TrimPreviewHost" Visibility="Collapsed" IsHitTestVisible="False" Background="{StaticResource BackgroundBrush}"
                      ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Image x:Name="TrimLeftImage" Stretch="Uniform" />
                        <TextBlock x:Name="TrimLeftCaption" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                   Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextBrush}" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <Image x:Name="TrimRightImage" Stretch="Uniform" />
                        <TextBlock x:Name="TrimRightCaption" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </Grid>
                <Canvas x:Name="TitleEditCanvas" Visibility="Collapsed">
                    <TextBox x:Name="TitleEditBox" AcceptsReturn="True" TextWrapping="Wrap" MinWidth="120" Padding="4,2"
                             Background="{StaticResource ScrimBrush}" BorderBrush="{StaticResource AccentBrush}" AutomationProperties.Name="Texto del título"
                             TextChanged="OnTitleEditChanged" LostFocus="OnTitleEditLostFocus" KeyDown="OnTitleEditKeyDown" />
                </Canvas>
            </Grid>
            <!-- Pantalla completa: los controles aparecen al mover el ratón y se van a los 2,5 s (PlayerView.FullScreen). -->
            <Grid x:Name="FullScreenControls" VerticalAlignment="Bottom" Visibility="Collapsed" Padding="16,12" ColumnSpacing="12"
                  Background="{StaticResource ScrimBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OverlayPlayButton" Style="{StaticResource AccentButtonStyle}" Width="40" Height="30" MinHeight="0" Padding="0"
                        FontFamily="{StaticResource IconFontFamily}" FontSize="{StaticResource IconFontSize}" Click="OnPlay"
                        AutomationProperties.Name="Reproducir o pausar" />
                <TextBlock x:Name="OverlayPosition" Grid.Column="1" Style="{StaticResource TimecodeTextStyle}" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />
                <Slider x:Name="OverlaySeek" Grid.Column="2" Minimum="0" Maximum="1" StepFrequency="0.0001" VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False" AutomationProperties.Name="Posición" ValueChanged="OnOverlaySeek" />
                <TextBlock x:Name="OverlayDuration" Grid.Column="3" Style="{StaticResource TimecodeTextStyle}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Grid>
            <player:ScopesPanel x:Name="Scopes" x:FieldModifier="internal" Grid.Column="1" Width="340" Visibility="Collapsed" />
            <meters:MetersView x:Name="Meters" x:FieldModifier="internal" Grid.Column="2" />
        </Grid>

        <Grid x:Name="Transport" Grid.Row="2" Padding="12,0" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{x:Bind Session.PositionText, Mode=OneWay, FallbackValue='0:00.000'}" Style="{StaticResource TimecodeTextStyle}"
                       FontSize="{StaticResource TitleFontSize}" Foreground="{StaticResource AccentBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <Button x:Name="PreviousFrameButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE892;" Click="OnPreviousFrame" />
                <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Width="40" Height="30" MinHeight="0" Padding="0"
                        FontFamily="{StaticResource IconFontFamily}" FontSize="{StaticResource IconFontSize}"
                        Content="{x:Bind player:PlayerView.PlayGlyph(Session.IsPlaying), Mode=OneWay, FallbackValue='&#xE768;'}" Click="OnPlay" />
                <Button x:Name="NextFrameButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE893;" Click="OnNextFrame" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" Text="{x:Bind Session.DurationText, Mode=OneWay, FallbackValue='0:00.000'}"
                       Style="{StaticResource TimecodeTextStyle}" FontSize="{StaticResource TitleFontSize}" Foreground="{StaticResource TextMutedBrush}" />
        </Grid>
        <!-- Editor de zonas propias, en el lugar del transporte: arrastrar mueve, las esquinas estiran; se guarda en complementos\propios. -->
        <Grid x:Name="SafeZoneEditBar" Grid.Row="2" Visibility="Collapsed" Padding="12,0" Background="{StaticResource BarBrush}"
              BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <!-- Los nombres ceden ancho y los botones nunca se cortan ni tocan el borde. -->
            <Grid ColumnSpacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="140" />
                    <ColumnDefinition Width="*" MaxWidth="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SafeZoneSetName" MinWidth="72" MinHeight="30" PlaceholderText="Nombre" AutomationProperties.Name="Nombre de las zonas" />
                <TextBox x:Name="SafeZoneLabel" Grid.Column="1" MinWidth="72" MinHeight="30" PlaceholderText="Etiqueta de la zona elegida" IsEnabled="False"
                         AutomationProperties.Name="Etiqueta de la zona" TextChanged="OnSafeZoneLabelChanged" />
                <Button Grid.Column="2" Content="Añadir zona" MinHeight="30" Padding="10,0" Click="OnSafeZoneAdd" />
                <Button x:Name="SafeZoneRemove" Grid.Column="3" Content="Quitar zona" MinHeight="30" Padding="10,0" IsEnabled="False" Click="OnSafeZoneRemove" />
                <Button Grid.Column="4" Content="Guardar" MinHeight="30" Padding="10,0" Style="{StaticResource AccentButtonStyle}" Click="OnSafeZoneSave" />
                <Button Grid.Column="5" Content="Cancelar" MinHeight="30" Padding="10,0" Click="OnSafeZoneCancel" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
