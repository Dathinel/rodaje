<?xml version="1.0" encoding="utf-8"?>
<!--
    Panel derecho: pestañas Propiedades (o la transición seleccionada), Texto, Velocidad, Filtros, Máscaras, Seguimiento, Dinámica, Historial y Trabajos. Cada pestaña
    es su propio control en su carpeta. Si los nombres no caben, las pestañas no elegidas muestran solo su ícono.
-->
<UserControl
    x:Class="Rodaje.App.Views.Inspector.InspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="using:Rodaje.App.Views.Inspector.Properties"
    xmlns:filters="using:Rodaje.App.Views.Inspector.Filters"
    xmlns:masks="using:Rodaje.App.Views.Inspector.Masks"
    xmlns:tracking="using:Rodaje.App.Views.Inspector.Tracking"
    xmlns:speed="using:Rodaje.App.Views.Inspector.Speed"
    xmlns:text="using:Rodaje.App.Views.Inspector.Text"
    xmlns:dynamics="using:Rodaje.App.Views.Inspector.Dynamics"
    xmlns:transition="using:Rodaje.App.Views.Inspector.Transition">

    <UserControl.Resources>
        <Style x:Key="InspectorTabStyle" TargetType="RadioButton" BasedOn="{StaticResource PanelTabStyle}">
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TabBar" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <!-- Si ni con íconos caben (panel muy estrecho), la tira se desplaza en horizontal: ninguna pestaña queda cortada. -->
            <ScrollViewer x:Name="TabScroller" Padding="0,0,0,8" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" ZoomMode="Disabled">
            <StackPanel x:Name="TabStrip" Orientation="Horizontal">
                <RadioButton x:Name="PropertiesTab" Style="{StaticResource InspectorTabStyle}" GroupName="InspectorTabs" IsChecked="True" Checked="OnTabChecked"
                             ToolTipService.ToolTip="Propiedades" AutomationProperties.Name="Propiedades">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9E9;" FontSize="{StaticResource IconFontSize}" Visibility="Collapsed" />
                        <TextBlock x:Name="PropertiesLabel" Text="Propiedades" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TextTab" Style="{StaticResource InspectorTabStyle}" GroupName="InspectorTabs" Checked="OnTabChecked"
                             ToolTipService.ToolTip="Texto" AutomationProperties.Name="Texto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D2;" FontSize="{StaticResource IconFontSize}" Visibility="Collapsed" />
                        <TextBlock x:Name="TextLabel" Text="Texto" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="SpeedTab" Style="{StaticResource InspectorTabStyle}" GroupName="InspectorTabs" Checked="OnTabChecked"
                             ToolTipService.ToolTip="Velocidad" AutomationProperties.Name="Velocidad">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEC4A;" FontSize="{StaticResource IconFontSize}" Visibility="Collapsed" />
                        <TextBlock x:Name="SpeedLabel" Text="Velocidad" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FiltersTab" Style="{StaticResource InspectorTabStyle}" GroupName="InspectorTabs" Checked="OnTabChecked"
                             ToolTipService.ToolTip="Filtros" AutomationProperties.Name="Filtros">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71C;" FontSize="{StaticResource IconFontSize}" Visibility="Collapsed" />
                        <TextBlock x:Name="FiltersLabel" Text="Filtros" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="MasksTab" Style="{StaticResource InspectorTabStyle}" GroupName="InspectorTabs" Checked="OnTabChecked"
                             ToolTipService.ToolTip="Máscaras" AutomationProperties.Name="Máscaras">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A8;" FontSize="{StaticResource IconFontSize}" Visibility="Collapsed" />
                        <TextBlock x:Name="MasksLabel" Text="Máscaras" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TrackingTab" Style="{StaticResource InspectorTabStyle}" GroupName="InspectorTabs" Checked="OnTabChecked"
                             ToolTipService.ToolTip="Seguimiento" AutomationProperties.Name="Seguimiento">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE707;" FontSize="{StaticResource IconFontSize}" Visibility="Collapsed" />
                        <TextBlock x:Name="TrackingLabel" Text="Seguimiento" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="DynamicsTab" Style="{StaticResource InspectorTabStyle}" GroupName="InspectorTabs" Checked="OnTabChecked"
                             ToolTipService.ToolTip="Dinámica" AutomationProperties.Name="Dinámica">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8D6;" FontSize="13" Visibility="Collapsed" />
                        <TextBlock x:Name="DynamicsLabel" Text="Dinámica" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TransitionTab" Style="{StaticResource InspectorTabStyle}" GroupName="InspectorTabs" Checked="OnTabChecked"
                             ToolTipService.ToolTip="Transición" AutomationProperties.Name="Transición" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D6;" FontSize="{StaticResource IconFontSize}" Visibility="Collapsed" />
                        <TextBlock x:Name="TransitionLabel" Text="Transición" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1">
            <properties:PropertiesPanel x:Name="PropertiesPanel" />
            <transition:TransitionPanel x:Name="TransitionPanel" Visibility="Collapsed" />
            <text:TextPanel x:Name="TextPanel" Visibility="Collapsed" />
            <speed:SpeedPanel x:Name="SpeedPanel" Visibility="Collapsed" />
            <filters:FiltersPanel x:Name="FiltersPanel" Visibility="Collapsed" />
            <masks:MasksPanel x:Name="MasksPanel" Visibility="Collapsed" />
            <tracking:TrackingPanel x:Name="TrackingPanel" Visibility="Collapsed" />
            <dynamics:DynamicsPanel x:Name="DynamicsPanel" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
