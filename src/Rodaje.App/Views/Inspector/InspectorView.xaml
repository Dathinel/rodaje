<?xml version="1.0" encoding="utf-8"?>
<!-- Panel derecho: pestañas Propiedades (o la transición seleccionada), Velocidad, Filtros, Historial y Trabajos. Cada pestaña es su propio control en su carpeta. -->
<UserControl
    x:Class="Rodaje.App.Views.Inspector.InspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="using:Rodaje.App.Views.Inspector.Properties"
    xmlns:filters="using:Rodaje.App.Views.Inspector.Filters"
    xmlns:speed="using:Rodaje.App.Views.Inspector.Speed"
    xmlns:history="using:Rodaje.App.Views.Inspector.History"
    xmlns:jobs="using:Rodaje.App.Views.Inspector.Jobs"
    xmlns:transition="using:Rodaje.App.Views.Inspector.Transition">

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource BarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PropertiesTab" Style="{StaticResource PanelTabStyle}" GroupName="InspectorTabs" Content="Propiedades" IsChecked="True" Checked="OnTabChecked" />
                <RadioButton x:Name="SpeedTab" Style="{StaticResource PanelTabStyle}" GroupName="InspectorTabs" Content="Velocidad" Checked="OnTabChecked" />
                <RadioButton x:Name="FiltersTab" Style="{StaticResource PanelTabStyle}" GroupName="InspectorTabs" Content="Filtros" Checked="OnTabChecked" />
                <RadioButton x:Name="HistoryTab" Style="{StaticResource PanelTabStyle}" GroupName="InspectorTabs" Content="Historial" Checked="OnTabChecked" />
                <RadioButton x:Name="JobsTab" Style="{StaticResource PanelTabStyle}" GroupName="InspectorTabs" Content="Trabajos" Checked="OnTabChecked" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <properties:PropertiesPanel x:Name="PropertiesPanel" />
            <transition:TransitionPanel x:Name="TransitionPanel" Visibility="Collapsed" />
            <speed:SpeedPanel x:Name="SpeedPanel" Visibility="Collapsed" />
            <filters:FiltersPanel x:Name="FiltersPanel" Visibility="Collapsed" />
            <history:HistoryPanel x:Name="HistoryPanel" Visibility="Collapsed" />
            <jobs:JobsPanel x:Name="JobsPanel" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
