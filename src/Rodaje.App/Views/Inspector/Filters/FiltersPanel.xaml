<?xml version="1.0" encoding="utf-8"?>
<!-- Pila de filtros del clip: activar, reordenar (flechas o arrastrando), quitar y añadir. -->
<UserControl
    x:Class="Rodaje.App.Views.Inspector.Filters.FiltersPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rodaje.App.Views.Inspector.Filters">

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="EmptyText" Grid.RowSpan="2" Style="{StaticResource PlaceholderTextStyle}" VerticalAlignment="Center" Margin="24,0"
                   Text="Selecciona un clip para ver y cambiar su pila de filtros." />

        <Grid x:Name="Header" Grid.Row="0" Padding="12,8" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ClipTitle" Style="{StaticResource PanelTitleTextStyle}" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Se aplican de arriba abajo." />
            </StackPanel>
            <ComboBox x:Name="AddBox" Grid.Column="1" PlaceholderText="Añadir filtro" MinWidth="140" Height="28"
                      FontSize="{StaticResource BodyFontSize}" SelectionChanged="OnAddSelected" />
        </Grid>

        <ListView x:Name="List" Grid.Row="1" Visibility="Collapsed" ItemsSource="{x:Bind Items}" SelectionMode="None"
                  CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="OnDragItemsCompleted"
                  Padding="0,0,0,8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="8,0,4,0" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FilterItem">
                    <Grid ColumnSpacing="4" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsEnabled}" Tag="{x:Bind EffectId}" Click="OnEnabledClick" MinWidth="0"
                                  ToolTipService.ToolTip="Activar o desactivar" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Opacity="{x:Bind TextOpacity}">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextStyle}" Visibility="{x:Bind NoteVisibility}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ToolButtonStyle}" Content="&#xE70E;" FontSize="11"
                                Tag="{x:Bind EffectId}" IsEnabled="{x:Bind CanMoveUp}" Click="OnMoveUpClick" ToolTipService.ToolTip="Subir" />
                        <Button Grid.Column="3" Style="{StaticResource ToolButtonStyle}" Content="&#xE70D;" FontSize="11"
                                Tag="{x:Bind EffectId}" IsEnabled="{x:Bind CanMoveDown}" Click="OnMoveDownClick" ToolTipService.ToolTip="Bajar" />
                        <Button Grid.Column="4" Style="{StaticResource ToolButtonStyle}" Content="&#xE711;" FontSize="11"
                                Tag="{x:Bind EffectId}" Click="OnRemoveClick" ToolTipService.ToolTip="Quitar" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="NoFiltersText" Grid.Row="1" Style="{StaticResource PlaceholderTextStyle}" Margin="24,24,24,0"
                   VerticalAlignment="Top" Visibility="Collapsed"
                   Text="Este clip no tiene filtros. Añade uno con el botón de arriba." />
    </Grid>
</UserControl>
