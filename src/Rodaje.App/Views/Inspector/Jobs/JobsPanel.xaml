<?xml version="1.0" encoding="utf-8"?>
<!-- Trabajos en segundo plano: proxies (con progreso y cancelar) y exportaciones (Views/Export/ExportJobsView). -->
<UserControl
    x:Class="Rodaje.App.Views.Inspector.Jobs.JobsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rodaje.App.Views.Inspector.Jobs"
    xmlns:export="using:Rodaje.App.Views.Export">

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Proxies" Style="{StaticResource PanelTitleTextStyle}" />
                <TextBlock x:Name="ProxySummary" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <Button x:Name="ClearButton" Grid.Column="1" Content="Limpiar terminados" Click="OnClearClick" IsEnabled="False" />
        </Grid>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource CaptionTextStyle}" Margin="12,4,12,8" TextWrapping="Wrap"
                   Text="No hay proxies en preparación. Rodaje los genera solo cuando un video pesa demasiado para la vista previa." />

        <ListView x:Name="List" Grid.Row="2" ItemsSource="{x:Bind Items}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,0,4,0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:JobItem">
                    <Grid Padding="0,6" ColumnSpacing="6" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyTextStyle}" ToolTipService.ToolTip="{x:Bind SourcePath}" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Status}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                                   Foreground="{StaticResource MeterHighBrush}" Opacity="{x:Bind ErrorOpacity}" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Status}" Style="{StaticResource CaptionTextStyle}" Opacity="{x:Bind PlainOpacity}" />
                        <ProgressBar Grid.Row="2" Value="{x:Bind Percent}" Maximum="100" Visibility="{x:Bind ActiveVisibility}" />
                        <Button Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource ToolButtonStyle}" Content="&#xE711;" FontSize="11"
                                Tag="{x:Bind SourcePath}" Visibility="{x:Bind ActiveVisibility}" Click="OnCancelClick"
                                ToolTipService.ToolTip="Cancelar" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer Grid.Row="3" MaxHeight="420" HorizontalScrollMode="Disabled" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <export:ExportJobsView x:Name="Exports" Padding="12,10,12,12" />
        </ScrollViewer>
    </Grid>
</UserControl>
