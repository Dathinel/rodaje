<?xml version="1.0" encoding="utf-8"?>
<!-- Velocidad del clip seleccionado, en secciones como las de Propiedades: deslizador logarítmico, duración resultante, mantener tono, curva y congelar. -->
<UserControl
    x:Class="Rodaje.App.Views.Inspector.Speed.SpeedPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:inspector="using:Rodaje.App.Views.Inspector"
    xmlns:speed="using:Rodaje.App.Views.Inspector.Speed">

    <Grid Background="{StaticResource PanelBrush}">
        <TextBlock x:Name="EmptyText" Style="{StaticResource PlaceholderTextStyle}" VerticalAlignment="Center" Margin="24,0"
                   Text="Selecciona un clip en la línea de tiempo para cambiar su velocidad." />

        <ScrollViewer x:Name="Body" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,12">
                <Grid Height="36" Padding="12,0,6,0">
                    <TextBlock x:Name="ClipTitle" Style="{StaticResource BodyTextStyle}" />
                </Grid>

                <inspector:InspectorSection x:Name="RateSection" Key="velocidad" Title="Velocidad">
                    <inspector:InspectorSection.Actions>
                        <Button x:Name="ResetButton" Style="{StaticResource ToolButtonStyle}" Width="24" Height="26" FontSize="11"
                                Content="&#xE72C;" Click="OnResetClick" AutomationProperties.Name="Restablecer la velocidad a 1×"
                                ToolTipService.ToolTip="Restablecer la velocidad a 1×" />
                    </inspector:InspectorSection.Actions>
                    <StackPanel Padding="12,3,6,0" Spacing="6">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="RateSlider" Minimum="0" Maximum="1000" StepFrequency="1" SmallChange="10" LargeChange="100"
                                    IsThumbToolTipEnabled="False" AutomationProperties.Name="Velocidad" Margin="0,-6,4,-6" VerticalAlignment="Center"
                                    MinWidth="0" ValueChanged="OnSliderValueChanged" />
                            <TextBox x:Name="RateBox" Grid.Column="1" MinWidth="0" Height="28" MinHeight="28" FontSize="{StaticResource BodyFontSize}"
                                     TextAlignment="Right" AutomationProperties.Name="Velocidad"
                                     ToolTipService.ToolTip="Escribe la velocidad, por ejemplo 1,5 o 150 %"
                                     KeyDown="OnBoxKeyDown" LostFocus="OnRateBoxLostFocus" />
                        </Grid>
                        <Grid Margin="0,-4,28,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="0,1×" Style="{StaticResource CaptionTextStyle}" TextTrimming="None" />
                                <TextBlock Grid.Column="1" Text="1×" Style="{StaticResource CaptionTextStyle}" TextTrimming="None" Margin="-8,0,0,0" />
                                <TextBlock Grid.Column="2" Text="10×" Style="{StaticResource CaptionTextStyle}" TextTrimming="None" Margin="-10,0,0,0" />
                                <TextBlock Grid.Column="2" Text="100×" Style="{StaticResource CaptionTextStyle}" TextTrimming="None" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="QuickPanel" ColumnSpacing="4" Margin="0,0,28,0" />

                        <Grid ColumnSpacing="4" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Duración" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="SourceDurationText" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right"
                                       ToolTipService.ToolTip="Lo que dura a 1×" />
                            <TextBox x:Name="DurationBox" Grid.Column="2" MinWidth="0" Height="28" MinHeight="28" FontSize="{StaticResource BodyFontSize}"
                                     TextAlignment="Right" AutomationProperties.Name="Duración en la línea de tiempo"
                                     ToolTipService.ToolTip="Escribe cuánto debe durar; la velocidad se calcula sola"
                                     KeyDown="OnBoxKeyDown" LostFocus="OnDurationBoxLostFocus" />
                        </Grid>

                        <Grid x:Name="WarningPanel" ColumnSpacing="6" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{StaticResource MeterMidBrush}" />
                            <TextBlock x:Name="WarningText" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                                       Foreground="{StaticResource MeterMidBrush}" />
                        </Grid>

                        <TextBlock x:Name="NoteText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed" />

                        <CheckBox x:Name="PitchBox" Content="Mantener tono" FontSize="{StaticResource BodyFontSize}" Click="OnPitchClick"
                                  ToolTipService.ToolTip="La voz y la música suenan igual de agudas a cualquier velocidad" />
                    </StackPanel>
                </inspector:InspectorSection>

                <inspector:InspectorSection x:Name="CurveSection" Key="velocidad-curva" Title="Curva">
                    <inspector:InspectorSection.Actions>
                        <Button x:Name="CurveResetButton" Style="{StaticResource ToolButtonStyle}" Width="24" Height="26" FontSize="11"
                                Content="&#xE72C;" Click="OnResetClick" AutomationProperties.Name="Quitar la curva y volver a 1×"
                                ToolTipService.ToolTip="Quitar la curva y volver a 1×" />
                    </inspector:InspectorSection.Actions>
                    <StackPanel Padding="12,3,6,0" Spacing="6">
                        <Grid x:Name="PresetGrid" ColumnSpacing="4" RowSpacing="4" />
                        <speed:SpeedCurveControl x:Name="CurveEditor" Margin="0,2,0,0" />
                        <Grid x:Name="CurveDurationRow" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Duración" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="CurveDurationText" Grid.Column="1" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Right"
                                       ToolTipService.ToolTip="Lo que dura el clip con esta curva" />
                        </Grid>
                        <TextBlock x:Name="CurveHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                </inspector:InspectorSection>

                <inspector:InspectorSection x:Name="MoreSection" Key="velocidad-mas" Title="Congelar e invertir">
                    <StackPanel Padding="12,3,6,0" Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FreezeButton" Click="OnFreezeClick" AutomationProperties.Name="Congelar el cuadro del cursor">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Congelar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="FreezeHint" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                                       Text="Detiene el cuadro del cursor durante 3 s." />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ReverseBox" Content="Invertir" FontSize="{StaticResource BodyFontSize}" IsEnabled="False" />
                            <TextBlock Grid.Column="1" Text="Próximamente" Style="{StaticResource CaptionTextStyle}" />
                        </Grid>
                    </StackPanel>
                </inspector:InspectorSection>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
