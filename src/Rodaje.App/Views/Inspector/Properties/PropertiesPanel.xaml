<?xml version="1.0" encoding="utf-8"?>
<!-- Propiedades del clip seleccionado: transformación con keyframes (video) y volumen con fundidos (audio). -->
<UserControl
    x:Class="Rodaje.App.Views.Inspector.Properties.PropertiesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rodaje.App.Views.Inspector.Properties">

    <Grid Background="{StaticResource PanelBrush}">
        <TextBlock x:Name="EmptyText" Style="{StaticResource PlaceholderTextStyle}" VerticalAlignment="Center" Margin="24,0"
                   Text="Selecciona un clip en la línea de tiempo para ver y animar sus propiedades." />

        <ScrollViewer x:Name="Body" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,4,0,12">
                <TextBlock x:Name="ClipTitle" Style="{StaticResource CaptionTextStyle}" Margin="12,4,12,2" />

                <StackPanel x:Name="VideoSection">
                    <Grid Height="32" Padding="12,0,12,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Transformación" Style="{StaticResource PanelTitleTextStyle}" />
                        <TextBlock x:Name="KeyframeTotal" Grid.Column="1" Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource KeyframeBrush}" />
                    </Grid>
                    <TextBlock x:Name="TransformNote" Style="{StaticResource CaptionTextStyle}" Margin="12,0,12,4"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <local:ParameterRow x:Name="XRow" />
                    <local:ParameterRow x:Name="YRow" />
                    <local:ParameterRow x:Name="ScaleRow" />
                    <local:ParameterRow x:Name="RotationRow" />
                    <local:ParameterRow x:Name="OpacityRow" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,10,12,0">
                        <Button x:Name="SavePresetButton" Content="Guardar como transición" Click="OnSavePresetClick"
                                ToolTipService.ToolTip="Guarda esta animación en tus complementos para usarla en otros clips" />
                    </StackPanel>
                    <TextBlock x:Name="SavePresetHint" Style="{StaticResource CaptionTextStyle}" Margin="12,4,12,0" TextWrapping="Wrap"
                               Text="Pon al menos dos keyframes en algún parámetro para guardar la animación." />
                </StackPanel>

                <Rectangle x:Name="SectionSeparator" Height="1" Margin="0,12" Fill="{StaticResource StrokeBrush}" />

                <StackPanel x:Name="AudioSection">
                    <Grid Height="32" Padding="12,0">
                        <TextBlock Text="Audio" Style="{StaticResource PanelTitleTextStyle}" />
                    </Grid>
                    <local:ParameterRow x:Name="GainRow" />
                    <local:ParameterRow x:Name="FadeInRow" />
                    <local:ParameterRow x:Name="FadeOutRow" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="12,4,12,0" TextWrapping="Wrap"
                               Text="El volumen y los fundidos se guardan con el proyecto y se aplicarán en la fase 5." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
