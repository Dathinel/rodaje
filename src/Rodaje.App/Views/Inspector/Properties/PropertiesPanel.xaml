<?xml version="1.0" encoding="utf-8"?>
<!--
    Propiedades del clip seleccionado en secciones plegables: «Posición y tamaño» y «Opacidad y mezcla» (video) y «Audio».
    Las acciones de toda la transformación (restablecer todo, guardar como transición) van en el menú «⋯» de la cabecera.
-->
<UserControl
    x:Class="Rodaje.App.Views.Inspector.Properties.PropertiesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:inspector="using:Rodaje.App.Views.Inspector"
    xmlns:local="using:Rodaje.App.Views.Inspector.Properties">

    <Grid Background="{StaticResource PanelBrush}">
        <TextBlock x:Name="EmptyText" Style="{StaticResource PlaceholderTextStyle}" VerticalAlignment="Center" Margin="24,0"
                   Text="Selecciona un clip en la línea de tiempo para ver y animar sus propiedades." />

        <ScrollViewer x:Name="Body" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,12">
                <Grid Height="36" Padding="12,0,8,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ClipTitle" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock x:Name="KeyframeTotal" Grid.Column="1" Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource KeyframeBrush}" TextTrimming="None" />
                    <Button x:Name="MoreButton" Grid.Column="2" Style="{StaticResource ToolButtonStyle}" Content="&#xE712;"
                            AutomationProperties.Name="Más acciones de la transformación"
                            ToolTipService.ToolTip="Más acciones: restablecer todo, guardar como transición">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="ResetAllItem" Text="Restablecer todo" Click="OnResetAllClick"
                                                ToolTipService.ToolTip="Vuelve posición, escala, rotación y opacidad a sus valores de fábrica y quita sus keyframes">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="SavePresetItem" Text="Guardar como transición…" Click="OnSavePresetClick"
                                                ToolTipService.ToolTip="Guarda esta animación en tus complementos para usarla en otros clips">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <TextBlock x:Name="TransformNote" Style="{StaticResource CaptionTextStyle}" Margin="12,0,12,8"
                           TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed"
                           Text="Transformar está desactivado en Filtros: los cambios se guardan pero no se ven." />

                <inspector:InspectorSection x:Name="PlacementSection" Key="posicion" Title="Posición y tamaño">
                    <inspector:InspectorSection.Actions>
                        <Button x:Name="PlacementReset" Style="{StaticResource ToolButtonStyle}" Width="24" Height="26" FontSize="{StaticResource IconFontSize}"
                                Content="&#xE72C;" Click="OnPlacementResetClick" AutomationProperties.Name="Restablecer posición y tamaño"
                                ToolTipService.ToolTip="Restablecer posición, escala, estiramiento y rotación" />
                    </inspector:InspectorSection.Actions>
                    <StackPanel>
                        <local:ParameterRow x:Name="XRow" />
                        <local:ParameterRow x:Name="YRow" />
                        <local:ParameterRow x:Name="ScaleRow" />
                        <local:ParameterRow x:Name="ScaleXRow" />
                        <local:ParameterRow x:Name="ScaleYRow" />
                        <local:ParameterRow x:Name="RotationRow" />
                        <Grid Padding="12,3,6,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Voltear" Style="{StaticResource LabelTextStyle}" ToolTipService.ToolTip="Espejar la imagen alrededor de su centro" />
                            <ToggleButton x:Name="FlipXButton" Grid.Column="1" HorizontalAlignment="Stretch" Height="28" MinWidth="0" Padding="6,0"
                                          FontSize="{StaticResource BodyFontSize}" Click="OnFlipClick" Tag="x"
                                          AutomationProperties.Name="Voltear en horizontal" ToolTipService.ToolTip="Voltear en horizontal (espejo)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="{StaticResource BodyFontSize}" />
                                    <TextBlock Text="Horizontal" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="FlipYButton" Grid.Column="2" HorizontalAlignment="Stretch" Height="28" MinWidth="0" Padding="6,0"
                                          FontSize="{StaticResource BodyFontSize}" Click="OnFlipClick" Tag="y"
                                          AutomationProperties.Name="Voltear en vertical" ToolTipService.ToolTip="Voltear en vertical (cabeza abajo)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8CB;" FontSize="{StaticResource BodyFontSize}" />
                                    <TextBlock Text="Vertical" />
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                    </StackPanel>
                </inspector:InspectorSection>

                <inspector:InspectorSection x:Name="ShapeSection" Key="forma" Title="Ancla e inclinación" CollapsedByDefault="True">
                    <inspector:InspectorSection.Actions>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="24" Height="26" FontSize="{StaticResource IconFontSize}"
                                Content="&#xE72C;" Click="OnShapeResetClick" AutomationProperties.Name="Restablecer ancla e inclinación"
                                ToolTipService.ToolTip="Restablecer ancla e inclinación" />
                    </inspector:InspectorSection.Actions>
                    <StackPanel>
                        <local:ParameterRow x:Name="AnchorXRow" />
                        <local:ParameterRow x:Name="AnchorYRow" />
                        <local:ParameterRow x:Name="SkewXRow" />
                        <local:ParameterRow x:Name="SkewYRow" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="12,2,12,4" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Escala, giro e inclinación pivotan en el ancla. En el visor, arrastra la cruz del ancla: la imagen no se mueve." />
                    </StackPanel>
                </inspector:InspectorSection>

                <inspector:InspectorSection x:Name="OpacitySection" Key="opacidad" Title="Opacidad y mezcla">
                    <StackPanel>
                        <local:ParameterRow x:Name="OpacityRow" />
                        <Grid Padding="12,4,8,4" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mezcla" Style="{StaticResource LabelTextStyle}" ToolTipService.ToolTip="Modo de mezcla" />
                            <ComboBox x:Name="BlendBox" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0" Height="28"
                                      FontSize="{StaticResource BodyFontSize}" AutomationProperties.Name="Modo de mezcla"
                                      SelectionChanged="OnBlendSelected" ToolTipService.ToolTip="Cómo se mezcla este clip con lo que tiene debajo" />
                        </Grid>
                    </StackPanel>
                </inspector:InspectorSection>

                <inspector:InspectorSection x:Name="MotionBlurSection" Key="desenfoque-movimiento" Title="Desenfoque de movimiento" CollapsedByDefault="True">
                    <StackPanel>
                        <Grid Padding="12,3,6,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activo" Style="{StaticResource LabelTextStyle}" />
                            <ToggleSwitch x:Name="MotionBlurSwitch" Grid.Column="1" MinWidth="0" OnContent="Sí" OffContent="No"
                                          Toggled="OnMotionBlurToggled" AutomationProperties.Name="Desenfoque de movimiento"
                                          ToolTipService.ToolTip="Promedia la capa a lo largo del obturador: lo que se mueve rápido se ve barrido, como en una cámara" />
                        </Grid>
                        <StackPanel x:Name="MotionBlurRows">
                            <local:ParameterRow x:Name="ShutterRow" />
                            <local:ParameterRow x:Name="PhaseRow" />
                            <local:ParameterRow x:Name="SamplesRow" />
                        </StackPanel>
                        <TextBlock x:Name="MotionBlurNote" Style="{StaticResource CaptionTextStyle}" Margin="12,2,12,4" TextWrapping="Wrap" TextTrimming="None"
                                   Text="180° es el obturador de cine. Igual en la vista previa y en la exportación; cada muestra es una pasada más de la capa." />
                    </StackPanel>
                </inspector:InspectorSection>

                <inspector:InspectorSection x:Name="PresetsSection" Key="animaciones" Title="Animaciones">
                    <StackPanel>
                        <Grid x:Name="PresetGrid" Margin="12,4,6,4" ColumnSpacing="4" RowSpacing="4" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="12,0,12,4" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Un clic pone sus keyframes a lo largo del clip, desde la posición y el tamaño que tiene; después se editan como cualquiera." />
                    </StackPanel>
                </inspector:InspectorSection>

                <inspector:InspectorSection x:Name="GraphSection" Key="grafica" Title="Gráfica">
                    <StackPanel Spacing="4" Padding="12,4,6,8">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="GraphParameterBox" HorizontalAlignment="Stretch" MinWidth="0" Height="28" FontSize="{StaticResource BodyFontSize}"
                                      SelectionChanged="OnGraphParameterSelected" AutomationProperties.Name="Parámetro de la gráfica"
                                      ToolTipService.ToolTip="Parámetro animado que se dibuja" />
                            <ToggleButton x:Name="GraphValueButton" Grid.Column="1" Content="Valor" Height="28" MinWidth="0" Padding="8,0" IsChecked="True"
                                          FontSize="{StaticResource BodyFontSize}" Click="OnGraphModeClick" Tag="value"
                                          ToolTipService.ToolTip="Gráfica del valor con los manejadores Bézier" />
                            <ToggleButton x:Name="GraphSpeedButton" Grid.Column="2" Content="Velocidad" Height="28" MinWidth="0" Padding="8,0"
                                          FontSize="{StaticResource BodyFontSize}" Click="OnGraphModeClick" Tag="speed"
                                          ToolTipService.ToolTip="Cuánto cambia por segundo: muestra dónde acelera y frena" />
                        </Grid>
                        <local:KeyframeGraphControl x:Name="Graph" />
                    </StackPanel>
                </inspector:InspectorSection>

                <inspector:InspectorSection x:Name="AudioSection" Key="audio" Title="Audio">
                    <inspector:InspectorSection.Actions>
                        <Button x:Name="AudioReset" Style="{StaticResource ToolButtonStyle}" Width="24" Height="26" FontSize="{StaticResource IconFontSize}"
                                Content="&#xE72C;" Click="OnAudioResetClick" AutomationProperties.Name="Restablecer el audio"
                                ToolTipService.ToolTip="Restablecer volumen y fundidos" />
                    </inspector:InspectorSection.Actions>
                    <StackPanel>
                        <local:ParameterRow x:Name="GainRow" />
                        <Grid Padding="12,4,8,4" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sonoridad" Style="{StaticResource LabelTextStyle}" ToolTipService.ToolTip="Sonoridad integrada (EBU R128)" />
                            <DropDownButton x:Name="NormalizeButton" Grid.Column="1" Content="Normalizar" Height="28" MinWidth="0"
                                            FontSize="{StaticResource BodyFontSize}" AutomationProperties.Name="Normalizar la sonoridad del clip"
                                            ToolTipService.ToolTip="Mide la sonoridad del clip solo (EBU R128) y ajusta su volumen al objetivo, en un paso del historial">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="NormalizeMenu" Placement="BottomEdgeAlignedLeft" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>
                        <Grid Padding="12,4,8,4" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Voz y música" Style="{StaticResource LabelTextStyle}"
                                       ToolTipService.ToolTip="Preajuste de ecualizador y compresor; los valores se ajustan en Filtros" />
                            <ComboBox x:Name="PresetBox" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0" Height="28"
                                      FontSize="{StaticResource BodyFontSize}" AutomationProperties.Name="Preajuste de ecualizador y compresor"
                                      SelectionChanged="OnPresetSelected"
                                      ToolTipService.ToolTip="Ecualizador y compresor en un paso; cada valor se ajusta en la pestaña Filtros" />
                        </Grid>
                        <TextBlock Text="Fundidos" Style="{StaticResource CaptionTextStyle}" Margin="12,8,12,0" />
                        <local:ParameterRow x:Name="FadeInRow" />
                        <local:ParameterRow x:Name="FadeOutRow" />
                    </StackPanel>
                </inspector:InspectorSection>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
