<?xml version="1.0" encoding="utf-8"?>
<!--
    Un parámetro en una línea: etiqueta de ancho fijo, deslizador, número con su unidad, rombo de keyframe y restablecer.
    Con el panel estrecho el deslizador baja a una segunda línea. Con keyframes aparece debajo la navegación y la curva.
-->
<UserControl
    x:Class="Rodaje.App.Views.Inspector.Properties.ParameterRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Padding="12,3,6,3" ColumnSpacing="4" Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="ResetItem" Text="Restablecer" Click="OnResetClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ClearKeyframesItem" Text="Quitar keyframes" Click="OnClearKeyframesClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LabelColumn" Width="76" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="58" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="LabelArea" ColumnSpacing="4" VerticalAlignment="Center" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LabelText" Style="{StaticResource LabelTextStyle}" />
            <TextBlock x:Name="AxisText" Grid.Column="1" Style="{StaticResource LabelTextStyle}" Foreground="{StaticResource TextBrush}"
                       FontWeight="SemiBold" TextTrimming="None" Margin="0,0,4,0" />
        </Grid>

        <Slider x:Name="ValueSlider" Grid.Column="1" Margin="2,-6,4,-6" VerticalAlignment="Center" MinWidth="0"
                IsThumbToolTipEnabled="False" ValueChanged="OnSliderValueChanged" />

        <NumberBox x:Name="ValueBox" Grid.Column="2" MinWidth="0" MinHeight="26" FontSize="{StaticResource BodyFontSize}"
                   SpinButtonPlacementMode="Hidden" ValueChanged="OnBoxValueChanged" />
        <TextBlock x:Name="UnitText" Grid.Column="3" Style="{StaticResource CaptionTextStyle}" TextTrimming="None" />

        <Button x:Name="KeyframeButton" Grid.Column="4" Style="{StaticResource ToolButtonStyle}" Width="24" Height="26"
                Click="OnKeyframeClick">
            <Grid>
                <TextBlock x:Name="DiamondEmpty" Text="&#x25C7;" FontFamily="{StaticResource UiFontFamily}" FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock x:Name="DiamondAnimated" Text="&#x25C7;" FontFamily="{StaticResource UiFontFamily}" FontSize="14"
                           Foreground="{StaticResource KeyframeBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="DiamondHere" Text="&#x25C6;" FontFamily="{StaticResource UiFontFamily}" FontSize="14"
                           Foreground="{StaticResource KeyframeBrush}" Visibility="Collapsed" />
            </Grid>
        </Button>
        <Button x:Name="ResetButton" Grid.Column="5" Style="{StaticResource ToolButtonStyle}" Width="24" Height="26" FontSize="11"
                Content="&#xE72C;" Click="OnResetClick" />

        <!-- Solo con keyframes: ir al anterior o al siguiente, la curva del keyframe del cursor y cuántos hay. -->
        <StackPanel x:Name="KeyframeStrip" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="2"
                    Margin="0,2,0,2" Visibility="Collapsed">
            <Button x:Name="PreviousButton" Style="{StaticResource ToolButtonStyle}" Width="22" Height="24" FontSize="10"
                    Content="&#xE76B;" Click="OnPreviousClick" ToolTipService.ToolTip="Keyframe anterior"
                    AutomationProperties.Name="Keyframe anterior" />
            <ComboBox x:Name="EaseBox" MinWidth="0" Width="96" Height="24" Padding="6,0,0,0"
                      FontSize="{StaticResource CaptionFontSize}" ToolTipService.ToolTip="Curva hasta el keyframe siguiente"
                      AutomationProperties.Name="Curva hasta el keyframe siguiente" SelectionChanged="OnEaseChanged" />
            <Button x:Name="NextButton" Style="{StaticResource ToolButtonStyle}" Width="22" Height="24" FontSize="10"
                    Content="&#xE76C;" Click="OnNextClick" ToolTipService.ToolTip="Keyframe siguiente"
                    AutomationProperties.Name="Keyframe siguiente" />
            <TextBlock x:Name="CountText" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource KeyframeBrush}"
                       Margin="4,0,0,0" TextTrimming="None" />
        </StackPanel>
    </Grid>
</UserControl>
