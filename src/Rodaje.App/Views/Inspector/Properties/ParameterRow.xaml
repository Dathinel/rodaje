<?xml version="1.0" encoding="utf-8"?>
<!-- Un parámetro: etiqueta, número, navegación, rombo de keyframe y restablecer arriba; deslizador y curva del keyframe abajo. -->
<UserControl
    x:Class="Rodaje.App.Views.Inspector.Properties.ParameterRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="12,6,8,6" RowSpacing="2" ColumnSpacing="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock x:Name="LabelText" Style="{StaticResource LabelTextStyle}" />
            <TextBlock x:Name="CountText" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource KeyframeBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,4,0">
            <NumberBox x:Name="ValueBox" Width="76" MinHeight="26" FontSize="{StaticResource BodyFontSize}"
                       SpinButtonPlacementMode="Hidden" ValueChanged="OnBoxValueChanged" />
            <TextBlock x:Name="UnitText" Style="{StaticResource CaptionTextStyle}" Width="16" />
        </StackPanel>

        <Button x:Name="PreviousButton" Grid.Column="2" Style="{StaticResource ToolButtonStyle}" Width="20" FontSize="10"
                Content="&#xE76B;" Click="OnPreviousClick" ToolTipService.ToolTip="Keyframe anterior" />
        <Button x:Name="KeyframeButton" Grid.Column="3" Style="{StaticResource ToolButtonStyle}" Width="24"
                Click="OnKeyframeClick" ToolTipService.ToolTip="Añadir o quitar keyframe en el cursor">
            <Grid>
                <TextBlock x:Name="DiamondEmpty" Text="&#x25C7;" FontFamily="{StaticResource UiFontFamily}" FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock x:Name="DiamondAnimated" Text="&#x25C7;" FontFamily="{StaticResource UiFontFamily}" FontSize="14"
                           Foreground="{StaticResource KeyframeBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="DiamondHere" Text="&#x25C6;" FontFamily="{StaticResource UiFontFamily}" FontSize="14"
                           Foreground="{StaticResource KeyframeBrush}" Visibility="Collapsed" />
            </Grid>
        </Button>
        <Button x:Name="NextButton" Grid.Column="4" Style="{StaticResource ToolButtonStyle}" Width="20" FontSize="10"
                Content="&#xE76C;" Click="OnNextClick" ToolTipService.ToolTip="Keyframe siguiente" />
        <Button x:Name="ResetButton" Grid.Column="5" Style="{StaticResource ToolButtonStyle}" Width="22" FontSize="11"
                Content="&#xE72C;" Click="OnResetClick" />

        <Slider x:Name="ValueSlider" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,-4,4,-4" VerticalAlignment="Center"
                IsThumbToolTipEnabled="False" ValueChanged="OnSliderValueChanged" />
        <ComboBox x:Name="EaseBox" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" MinWidth="0" Width="68" Height="24"
                  Padding="6,0,0,0" FontSize="{StaticResource CaptionFontSize}" Visibility="Collapsed"
                  ToolTipService.ToolTip="Curva hasta el keyframe siguiente" SelectionChanged="OnEaseChanged" />
    </Grid>
</UserControl>
