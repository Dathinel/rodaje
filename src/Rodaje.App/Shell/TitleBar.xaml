<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de título propia: menú, nombre del proyecto y si está guardado, GPU y cifras, y EXPORTAR. -->
<UserControl
    x:Class="Rodaje.App.Shell.TitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rodaje.App.Shell">

    <Grid Background="{StaticResource BackgroundBrush}" Height="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="CaptionInset" x:FieldModifier="internal" Width="138" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="12,0,8,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <local:AppLogo Width="18" Height="18" />
            <TextBlock Text="Rodaje" FontWeight="SemiBold" FontSize="{StaticResource TitleFontSize}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <MenuBar x:Name="Menu" Grid.Column="1" VerticalAlignment="Center">
            <MenuBarItem Title="Archivo">
                <MenuFlyoutItem Text="Proyecto nuevo" Tag="file.new" Click="OnActionClick" />
                <MenuFlyoutSubItem x:Name="TemplatesMenu" Text="Proyecto nuevo desde plantilla" />
                <MenuFlyoutItem Text="Abrir proyecto..." Tag="file.open" Click="OnActionClick" />
                <MenuFlyoutItem Text="Guardar" Tag="file.save" Click="OnActionClick" />
                <MenuFlyoutItem Text="Guardar como..." Tag="file.saveAs" Click="OnActionClick" />
                <MenuFlyoutItem Text="Guardar como plantilla..." Click="OnSaveTemplateClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Importar medios..." Tag="file.import" Click="OnActionClick" />
                <MenuFlyoutItem Text="Importar CinemaDNG..." Tag="file.importCinemaDng" Click="OnActionClick" />
                <MenuFlyoutItem Text="Importar subtítulos..." Tag="file.importSubtitles" Click="OnActionClick" />
                <MenuFlyoutItem Text="Carpetas vigiladas..." Tag="file.watchedFolders" Click="OnActionClick" />
                <MenuFlyoutItem Text="Exportar..." Tag="file.export" Click="OnActionClick" />
                <MenuFlyoutItem Text="Exportar fotograma..." Tag="file.exportFrame" Click="OnActionClick" />
                <MenuFlyoutItem Text="Exportar subtítulos..." Tag="file.exportSubtitles" Click="OnActionClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Carpeta de medios generados..." Click="OnGeneratedFolderClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Salir" Click="OnExitClick" />
            </MenuBarItem>
            <MenuBarItem Title="Editar">
                <MenuFlyoutItem x:Name="UndoItem" Text="Deshacer" Tag="edit.undo" Click="OnActionClick" />
                <MenuFlyoutItem x:Name="RedoItem" Text="Rehacer" Tag="edit.redo" Click="OnActionClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Cortar en el cursor" Tag="edit.split" Click="OnActionClick" />
                <MenuFlyoutItem Text="Recortar el inicio hasta el cursor" Tag="edit.trimStart" Click="OnActionClick" />
                <MenuFlyoutItem Text="Recortar el final hasta el cursor" Tag="edit.trimEnd" Click="OnActionClick" />
                <MenuFlyoutItem Text="Borrar" Tag="edit.delete" Click="OnActionClick" />
                <MenuFlyoutItem Text="Seleccionar todo" Tag="edit.selectAll" Click="OnActionClick" />
            </MenuBarItem>
            <MenuBarItem Title="Secuencia">
                <MenuFlyoutItem Text="Añadir texto" Tag="clip.addText" Click="OnActionClick" />
                <MenuFlyoutItem Text="Añadir pista de subtítulos" Tag="timeline.subtitleTrack" Click="OnActionClick" />
            </MenuBarItem>
            <MenuBarItem Title="Herramientas">
                <MenuFlyoutSubItem Text="Audio">
                    <MenuFlyoutItem Text="Quitar silencios..." Tag="analysis.silences" Click="OnActionClick" />
                    <MenuFlyoutItem Text="Detectar ritmo..." Tag="analysis.beats" Click="OnActionClick" />
                    <MenuFlyoutItem Text="Bajar música bajo la voz..." Tag="analysis.ducking" Click="OnActionClick" />
                    <MenuFlyoutItem Text="Reducir ruido..." Tag="analysis.noise" Click="OnActionClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Imagen">
                    <MenuFlyoutItem Text="Estabilizar..." Tag="analysis.stabilize" Click="OnActionClick" />
                    <MenuFlyoutItem Text="Color automático..." Tag="analysis.autocolor" Click="OnActionClick" />
                    <MenuFlyoutItem Text="Balance de blancos automático..." Tag="analysis.whitebalance" Click="OnActionClick" />
                    <MenuFlyoutItem Text="Quitar fondo..." Tag="vision.removeBackground" Click="OnActionClick" />
                    <MenuFlyoutItem Text="Reencuadre automático..." Tag="vision.reframe" Click="OnActionClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Texto y voz">
                    <MenuFlyoutItem Text="Subtítulos automáticos..." Tag="tools.autoSubtitles" Click="OnActionClick" />
                    <MenuFlyoutItem Text="Traducir pista..." Tag="tools.translateTrack" Click="OnActionClick" />
                    <MenuFlyoutItem Text="Texto a voz..." Tag="voice.textToSpeech" Click="OnActionClick" />
                    <MenuFlyoutItem Text="Grabar voz en off..." Tag="audio.voiceOver" Click="OnActionClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Calidad de la IA">
                    <RadioMenuFlyoutItem x:Name="AiQualityAuto" Text="Automática (según el equipo)" GroupName="AiQuality" Tag="Auto" Click="OnAiQualityClick" />
                    <RadioMenuFlyoutItem x:Name="AiQualityFast" Text="Rápida" GroupName="AiQuality" Tag="Fast" Click="OnAiQualityClick" />
                    <RadioMenuFlyoutItem x:Name="AiQualityMax" Text="Máxima" GroupName="AiQuality" Tag="Max" Click="OnAiQualityClick" />
                </MenuFlyoutSubItem>
            </MenuBarItem>
            <MenuBarItem Title="Ver">
                <MenuFlyoutItem Text="Propiedades" Tag="inspector:Properties" Click="OnInspectorClick" />
                <MenuFlyoutItem Text="Texto" Tag="inspector:Text" Click="OnInspectorClick" />
                <MenuFlyoutItem Text="Filtros" Tag="inspector:Filters" Click="OnInspectorClick" />
                <MenuFlyoutItem Text="Historial" Tag="inspector:History" Click="OnInspectorClick" />
                <MenuFlyoutItem Text="Trabajos" Tag="inspector:Jobs" Click="OnInspectorClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="WorkspaceMenu" Text="Espacio de trabajo" />
                <MenuFlyoutItem Text="Mezclador" Tag="view.mixer" Click="OnActionClick" />
                <MenuFlyoutItem Text="Pantalla completa" Tag="view.playerFullScreen" Click="OnActionClick" />
                <MenuFlyoutItem x:Name="SecondScreenItem" Text="Visor en otra pantalla" Tag="view.secondScreen" Click="OnActionClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Proxies en la vista previa">
                    <RadioMenuFlyoutItem x:Name="ProxyAuto" Text="Automático" GroupName="Proxies" Tag="Auto" Click="OnProxyClick" />
                    <RadioMenuFlyoutItem x:Name="ProxyAlways" Text="Siempre que haya" GroupName="Proxies" Tag="Always" Click="OnProxyClick" />
                    <RadioMenuFlyoutItem x:Name="ProxyNever" Text="Nunca (originales)" GroupName="Proxies" Tag="Never" Click="OnProxyClick" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="AutoProxiesItem" Text="Generar al importar los videos pesados" Click="OnAutoProxiesClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="NewVideoTracksMenu" Text="Pistas de video de un proyecto nuevo" />
                <MenuFlyoutSubItem x:Name="NewAudioTracksMenu" Text="Pistas de audio de un proyecto nuevo" />
                <MenuFlyoutSubItem x:Name="LinkedAudioMenu" Text="Pistas de video que traen su audio" />
                <MenuFlyoutSubItem Text="Calidad de la vista previa">
                    <RadioMenuFlyoutItem x:Name="QualityAuto" Text="Automática" GroupName="Quality" Tag="Auto" Click="OnQualityClick" />
                    <RadioMenuFlyoutItem x:Name="QualityFull" Text="Completa" GroupName="Quality" Tag="Full" Click="OnQualityClick" />
                    <RadioMenuFlyoutItem x:Name="QualityHalf" Text="Mitad" GroupName="Quality" Tag="Half" Click="OnQualityClick" />
                    <RadioMenuFlyoutItem x:Name="QualityQuarter" Text="Cuarto" GroupName="Quality" Tag="Quarter" Click="OnQualityClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Acercar" Tag="timeline.zoomIn" Click="OnActionClick" />
                <MenuFlyoutItem Text="Alejar" Tag="timeline.zoomOut" Click="OnActionClick" />
            </MenuBarItem>
            <MenuBarItem Title="Complementos">
                <MenuFlyoutItem Text="Gestor de complementos..." Tag="view.plugins" Click="OnActionClick" />
            </MenuBarItem>
            <MenuBarItem Title="Atajos">
                <MenuFlyoutItem Text="Atajos de teclado..." Tag="view.shortcuts" Click="OnActionClick" />
                <MenuFlyoutSeparator />
                <RadioMenuFlyoutItem x:Name="PresetRodaje" Text="Estilo Rodaje" GroupName="Preset" Tag="Rodaje" Click="OnPresetClick" />
                <RadioMenuFlyoutItem x:Name="PresetAgile" Text="Estilo Ágil" GroupName="Preset" Tag="Agile" Click="OnPresetClick" />
                <RadioMenuFlyoutItem x:Name="PresetClassic" Text="Estilo Clásico" GroupName="Preset" Tag="Classic" Click="OnPresetClick" />
            </MenuBarItem>
            <MenuBarItem Title="Ayuda">
                <MenuFlyoutItem Text="Recorrido inicial" Tag="help.tour" Click="OnActionClick" />
                <MenuFlyoutItem Text="Volver a mostrar las pistas" Tag="help.resetHints" Click="OnActionClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Acerca de Rodaje..." Click="OnAboutClick" />
                <MenuFlyoutItem Text="Repositorio oficial" Click="OnUpstreamClick" />
            </MenuBarItem>
        </MenuBar>

        <Border x:Name="DragRegion" x:FieldModifier="internal" Grid.Column="2" Background="Transparent">
            <!-- En el centro y sin cortarse por los lados: con poco ancho, el nombre se acorta con puntos suspensivos. -->
            <Grid ColumnSpacing="8" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Right" Text="{x:Bind Session.ProjectName, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BodyTextStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Session.SaveStateText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextStyle}" />
            </Grid>
        </Border>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12" Margin="0,0,12,0">
            <!-- Crédito upstream obligatorio (LICENSE, términos adicionales 1 y 3): siempre visible y con enlace. -->
            <HyperlinkButton x:Name="UpstreamCredit" x:FieldModifier="internal" Padding="4,2" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextMutedBrush}" Click="OnUpstreamClick" />
            <TextBlock x:Name="StatsText" MaxWidth="220" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>

        <Button x:Name="ExportButton" x:FieldModifier="internal" Grid.Column="4" Content="EXPORTAR" Margin="0,0,12,0"
                Style="{StaticResource AccentButtonStyle}" Click="OnExportClick" />
    </Grid>
</UserControl>
