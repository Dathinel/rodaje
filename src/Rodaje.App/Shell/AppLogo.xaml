                <Path Fill="{StaticResource AccentBrush}" Data="M112 44H140A64 64 0 0 1 140 172H112V128H140A20 20 0 0 0 140 88H112Z" />
                <Path Fill="{StaticResource AccentBrush}" Data="M118 160H170L218 216H166Z" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
