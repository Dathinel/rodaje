<?xml version="1.0" encoding="utf-8"?>
<!--
    Distribución D-018: barra de título; biblioteca con su riel, reproductor y panel derecho; línea de tiempo abajo. Los
    separadores cambian el tamaño de cada zona y se recuerda en ajustes.json (la línea de tiempo, como proporción del alto). Las páginas de atajos y complementos se
    abren encima (ModalLayer).
-->
<Window
    x:Class="Rodaje.App.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Rodaje.App.Shell"
    xmlns:library="using:Rodaje.App.Views.Library"
    xmlns:player="using:Rodaje.App.Views.Player"
    xmlns:inspector="using:Rodaje.App.Views.Inspector"
    xmlns:timeline="using:Rodaje.App.Views.Timeline"
    xmlns:mixer="using:Rodaje.App.Views.Mixer"
    xmlns:history="using:Rodaje.App.Views.Inspector.History"
    xmlns:jobs="using:Rodaje.App.Views.Inspector.Jobs"
    Title="Rodaje">

    <Grid x:Name="Root" Background="{StaticResource BackgroundBrush}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="8" />
            <RowDefinition x:Name="TimelineRow" Height="300" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <shell:TitleBar x:Name="TitleBar" />

        <!-- Por encima de la capa modal: los avisos de las páginas (Atajos, Complementos) también se ven aquí. -->
        <InfoBar x:Name="Notification" Grid.Row="1" Canvas.ZIndex="1" IsOpen="False" IsClosable="True" Margin="0" CornerRadius="0">
            <InfoBar.ActionButton>
                <Button x:Name="NotificationButton" Visibility="Collapsed" Click="OnNotificationButtonClick" />
            </InfoBar.ActionButton>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="NotificationSecondaryButton" Visibility="Collapsed" Click="OnNotificationSecondaryButtonClick" />
                <!-- Una acción larga en marcha (LongActionService): avance con porcentaje, o indeterminado si no se sabe. -->
                <StackPanel x:Name="NotificationProgress" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12" Visibility="Collapsed">
                    <ProgressBar x:Name="NotificationProgressBar" Width="280" Maximum="1" VerticalAlignment="Center"
                                 AutomationProperties.Name="Avance" />
                    <TextBlock x:Name="NotificationProgressText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </InfoBar>

        <Grid x:Name="MainArea" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="320" MinWidth="0" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition x:Name="InspectorColumn" Width="320" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <library:LibraryView x:Name="Library" />
            <shell:PaneSplitter x:Name="LibrarySplitter" Grid.Column="1" TargetIndex="0" GrowsTowardEnd="True" MinSize="220" MaxSize="900" />
            <player:PlayerView x:Name="Player" Grid.Column="2" />
            <shell:PaneSplitter x:Name="InspectorSplitter" Grid.Column="3" TargetIndex="4" GrowsTowardEnd="False" MinSize="240" MaxSize="900" />
            <inspector:InspectorView x:Name="Inspector" Grid.Column="4" />
        </Grid>

        <shell:PaneSplitter x:Name="TimelineSplitter" Grid.Row="3" ResizesColumn="False" ShowGrip="True" TargetIndex="4" GrowsTowardEnd="False" MaxSize="1400" ReserveForStar="240"
                            ToolTipService.ToolTip="Arrastra para cambiar el alto de la línea de tiempo. Doble clic: más visor o más línea de tiempo"
                            AutomationProperties.Name="Separador del visor y la línea de tiempo" />

        <Grid Grid.Row="4">
            <timeline:TimelineView x:Name="Timeline" />
            <mixer:MixerView x:Name="Mixer" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="5" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
            <!-- «Guardado hace N min» o «Copia automática hace N min»: lo refresca el temporizador de ajustes (SaveAge). -->
            <TextBlock x:Name="SaveStatusText" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"
                       AutomationProperties.Name="Último guardado" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="HistoryButton" Content="Historial" ToolTipService.ToolTip="Historial del proyecto (Ctrl+H)">
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <history:HistoryPanel x:Name="HistoryPanel" Width="360" Height="480" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="JobsButton" ToolTipService.ToolTip="Trabajos en segundo plano">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE9F5;" FontSize="{StaticResource IconFontSize}" />
                            <ProgressRing x:Name="JobsProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="JobsButtonText" Text="Trabajos" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <jobs:JobsPanel x:Name="JobsPanel" Width="360" Height="480" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ModalLayer" Grid.RowSpan="6" Visibility="Collapsed" Background="{StaticResource ScrimBrush}">
            <Border x:Name="ModalFrame" Margin="48,56,48,40" MaxWidth="1100" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Style="{StaticResource PanelHeaderStyle}" Height="44">
                        <TextBlock x:Name="ModalTitle" Style="{StaticResource HeaderTextStyle}" />
                        <Button Style="{StaticResource ToolButtonStyle}" HorizontalAlignment="Right" Content="&#xE711;" Click="OnCloseModal"
                                ToolTipService.ToolTip="Cerrar (Esc)" />
                    </Grid>
                    <ContentPresenter x:Name="ModalContent" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
