<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Formato .paquete (docs/formato-paquete.md): manifiesto, cargador, instalador y catálogo. Sin dependencias ni WinUI,
    para que otros programas de Dathinel lo compartan cuando salga a su propio repositorio.
  -->
  <PropertyGroup>
    <RootNamespace>Rodaje.Paquetes</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rodaje.Paquetes.Tests" />
  </ItemGroup>

</Project>
