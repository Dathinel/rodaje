<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FotoToma.Media</RootNamespace>
    <!-- Demultiplexado y decodificación con FFmpeg (LGPL, cargado por ruta absoluta) y Direct3D 11 -->
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FotoToma.Media.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FotoToma.Core\FotoToma.Core.csproj" />
    <ProjectReference Include="..\FotoToma.Playback\FotoToma.Playback.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLinked" Version="9.0.1.1" />
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
  </ItemGroup>

</Project>
