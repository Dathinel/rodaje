<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WASAPI y MMCSS solo existen en Windows: el destino -windows deja que el analizador de plataforma lo sepa -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FotoToma.Audio</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FotoToma.Audio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FotoToma.Playback\FotoToma.Playback.csproj" />
  </ItemGroup>

</Project>
