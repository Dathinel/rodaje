<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rodaje.Core</RootNamespace>
    <!-- El núcleo debe poder compilarse con Native AOT: sin reflexión, JSON con generador de código -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rodaje.Core.Tests" />
  </ItemGroup>

</Project>
