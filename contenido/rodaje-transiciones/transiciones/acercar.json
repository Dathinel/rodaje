{
  "format": "rodaje.preset",
  "version": 2,
  "id": "acercar",
  "name": "Acercar",
  "description": "Fundido mientras la cámara se acerca.",
  "kind": "transition",
  "durationSeconds": 0.5,
  "mix": "rodaje.crossfade",
  "reference": {
    "width": 1920,
    "height": 1080
  },
  "outgoing": {
    "scale": [
      {
        "t": 0,
        "value": 1,
        "interp": "easeIn"
      },
      {
        "t": 0.5,
        "value": 1.5,
        "interp": "linear"
      }
    ]
  },
  "incoming": {
    "scale": [
      {
        "t": 0,
        "value": 0.85,
        "interp": "easeOut"
      },
      {
        "t": 0.5,
        "value": 1,
        "interp": "linear"
      }
    ]
  }
}
